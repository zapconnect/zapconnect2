<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Agendamentos • ZapConnect</title>

  <%- include("partials/app-head-core") %>
  <link rel="stylesheet" href="/css/agendamentos.css">
  <link rel="stylesheet" href="/css/app-shell.css">
  <script src="/js/app-shell.js" defer></script>
</head>

<body class="has-app-sidebar app-screen-framed" data-user-tz="<%= user.timezone_offset || -180 %>" data-default-ddi="<%= user.default_ddi || '55' %>">
  <%- include("partials/app-sidebar", { activePage: "agendamentos" }) %>

  <header class="topbar">
    <div class="brand">
      <i class="fa-solid fa-calendar-check"></i>
      <h1>Agendamentos</h1>
    </div>
  </header>

  <main class="container app-screen-scroll">
    <div class="agend-layout">
      <aside class="card agend-calendar-panel">
        <div class="calendar-panel-head">
          <div>
            <span class="calendar-kicker">Visão mensal</span>
            <h2><i class="fa-solid fa-calendar-days"></i> Calendário</h2>
          </div>
          <button class="btn-secondary btn-inline btn-calendar-today" type="button" id="btnCalendarToday">
            <i class="fa-solid fa-bullseye"></i>
            Hoje
          </button>
        </div>

        <div class="cal-header">
          <button type="button" class="calendar-nav-btn" id="btnCalendarPrev" aria-label="Mês anterior">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <span id="calendarMonthLabel">Carregando...</span>
          <button type="button" class="calendar-nav-btn" id="btnCalendarNext" aria-label="Próximo mês">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>

        <div id="calendarGrid" class="cal-grid">
          <div class="loading-card">Carregando calendário...</div>
        </div>

        <div class="calendar-legend">
          <span class="legend-item"><i class="legend-dot legend-pending"></i>Pendente</span>
          <span class="legend-item"><i class="legend-dot legend-sent"></i>Enviado</span>
          <span class="legend-item"><i class="legend-dot legend-failed"></i>Falha</span>
        </div>
      </aside>

      <section class="card agend-day-panel">
        <div class="agend-day-toolbar">
          <div>
            <span class="calendar-kicker">Agenda do dia</span>
            <div class="agend-day-header" id="agendDayHeader">Selecione um dia</div>
            <p class="agend-day-copy" id="agendDayCopy">
              O calendário destaca a carga de mensagens por data para você agir sem rolar uma lista inteira.
            </p>
          </div>

          <div class="agend-day-actions">
            <button class="btn-secondary btn-inline" type="button" id="btnDayToday">
              <i class="fa-solid fa-calendar-day"></i>
              Ir para hoje
            </button>
            <button class="btn-primary btn-inline" type="button" id="btnNovoAgend">
              <i class="fa-solid fa-plus"></i>
              Novo agendamento
            </button>
          </div>
        </div>

        <div id="statusChips" class="status-chip-row" aria-label="Filtros rápidos de status">
          <button class="status-chip is-active" type="button" data-status-chip="all" onclick="setStatusFilterQuick('all')">
            <span>Todos</span>
            <strong id="statusCountAll">0</strong>
          </button>
          <button class="status-chip" type="button" data-status-chip="pending" onclick="setStatusFilterQuick('pending')">
            <span>Pendentes</span>
            <strong id="statusCountPending">0</strong>
          </button>
          <button class="status-chip" type="button" data-status-chip="sent" onclick="setStatusFilterQuick('sent')">
            <span>Enviados</span>
            <strong id="statusCountSent">0</strong>
          </button>
          <button class="status-chip" type="button" data-status-chip="failed" onclick="setStatusFilterQuick('failed')">
            <span>Falha</span>
            <strong id="statusCountFailed">0</strong>
          </button>
          <button class="status-chip" type="button" data-status-chip="processing" id="statusChipProcessing" onclick="setStatusFilterQuick('processing')" hidden>
            <span>Em envio</span>
            <strong id="statusCountProcessing">0</strong>
          </button>
        </div>

        <div class="agend-toolbar">
          <div class="field native-filter" hidden>
            <label><i class="fa-solid fa-filter"></i> Status</label>
            <select id="statusFilter" onchange="resetPageAndLoad()">
              <option value="all">Todos</option>
              <option value="pending">Pendentes</option>
              <option value="processing">Em envio</option>
              <option value="sent">Enviados</option>
              <option value="failed">Falhos</option>
            </select>
          </div>
          <div class="field">
            <label><i class="fa-solid fa-magnifying-glass"></i> Buscar número ou mensagem</label>
            <input type="text" id="searchTerm" placeholder="54999 ou parte da mensagem" oninput="renderSelectedDay()" />
          </div>
        </div>

        <div class="list-summary-bar day-summary-bar">
          <span id="agSummaryCount">Selecione um dia no calendário</span>
          <span id="agSummaryHint">Clique em um dia para abrir somente os agendamentos daquela data.</span>
        </div>

        <div id="agendDayList" class="schedule-list">
          <div class="empty-schedule-state">
            <strong>Selecione um dia</strong>
            <span>Os itens daquele dia aparecem aqui com ações rápidas de editar, cancelar ou reenviar.</span>
          </div>
        </div>
      </section>
    </div>
  </main>

  <div id="scheduleFormModal" class="modal hidden modal-shell" aria-hidden="true">
    <div class="modal-content modal-content-form">
      <div class="modal-form-top">
        <div>
          <span class="calendar-kicker">Compositor de envio</span>
          <h2 id="formModalTitle"><i class="fa-solid fa-plus"></i> Novo agendamento</h2>
          <p class="modal-form-copy" id="formModalCopy">
            Monte a mensagem, anexe mídia e confirme o horário sem sair da visão mensal do calendário.
          </p>
        </div>
        <button class="btn-secondary modal-close-btn" type="button" id="btnCloseAgendModal">
          <i class="fa-solid fa-xmark"></i>
          Fechar
        </button>
      </div>

      <div class="form-grid schedule-form-grid">
        <div class="form-fields">
          <div class="field">
            <label><i class="fa-solid fa-earth-americas"></i> Fuso horário</label>
            <div class="two-cols">
              <select id="timezoneSelect">
                <option value="-180">(UTC-03:00) Brasília</option>
                <option value="-240">(UTC-04:00) Manaus</option>
                <option value="-120">(UTC-02:00) Fernando de Noronha</option>
                <option value="0">(UTC+00:00) Londres</option>
                <option value="60">(UTC+01:00) Lisboa</option>
                <option value="-300">(UTC-05:00) NY/EST</option>
              </select>
              <button class="btn-secondary" type="button" onclick="salvarTimezone()">Salvar fuso</button>
            </div>
            <small class="hint">Usado para interpretar data/hora dos agendamentos.</small>
          </div>
          <label>
            <i class="fa-solid fa-phone"></i>
            Lista de números
          </label>
          <div class="inline-actions">
            <button class="btn-secondary" type="button" onclick="document.getElementById('csvInput').click()">
              <i class="fa-solid fa-file-csv"></i>
              Importar CSV
            </button>
            <input type="file" id="csvInput" accept=".csv,text/csv" style="display:none" onchange="importarCSV(this)">
          </div>
          <textarea id="nums" rows="4" placeholder="<%= user.default_ddi || '55' %> (49) 99999-9999&#10;<%= user.default_ddi || '55' %> (11) 98888-8888" oninput="handleNumsInput()"></textarea>
          <div class="field-hint" id="num-count">0 números</div>
          <small class="hint">O campo aplica máscara automática e inicia cada linha com DDI <%= user.default_ddi || '55' %>.</small>

          <label>
            <i class="fa-solid fa-message"></i>
            Mensagem
          </label>
          <textarea id="msg" rows="3" placeholder="Digite a mensagem..." oninput="updatePreview()"></textarea>
          <small class="hint">
            Personalize com variáveis: {{nome}}, {{numero}}, {{data}}, {{hora}}, {{pedido}} ou qualquer coluna do CSV (ex.: {{email}}).
          </small>

          <label>
            <i class="fa-solid fa-paperclip"></i>
            Arquivo (opcional)
          </label>

          <div class="file-upload-area" id="fileUploadArea" onclick="document.getElementById('fileInput').click()">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <span id="fileUploadLabel">Clique para selecionar imagem, vídeo, PDF ou áudio</span>
            <span class="file-upload-hint">Máximo 15MB</span>
          </div>
          <input type="file" id="fileInput"
            accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.zip,.txt"
            style="display:none"
            onchange="handleFileSelect(this)">

          <div id="filePreview" class="file-preview-area" style="display:none;">
            <img id="previewImg" style="display:none;" alt="preview">
            <div id="previewDoc" class="preview-doc" style="display:none;">
              <i class="fa-solid fa-file"></i>
              <span id="previewDocName"></span>
            </div>
            <button class="btn-remove-file" type="button" onclick="clearFile()" title="Remover arquivo">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <div class="two-cols">
            <div class="field">
              <label>
                <i class="fa-solid fa-clock"></i>
                Data e Hora
              </label>
              <input type="datetime-local" id="sendAt">
            </div>
            <div class="field">
              <label>
                <i class="fa-solid fa-rotate"></i>
                Repetição
              </label>
              <select id="recurrence" onchange="toggleRecurrenceEnd()">
                <option value="none">Não repetir (único)</option>
                <option value="daily">Diario</option>
                <option value="weekly">Semanal</option>
                <option value="monthly">Mensal</option>
              </select>
            </div>
            <div class="field" id="recurrenceEndField" style="display:none;">
              <label>
                <i class="fa-solid fa-flag-checkered"></i>
                Encerrar recorrência em
              </label>
              <input type="date" id="recurrenceEnd">
              <small class="hint">Opcional. Último dia para repetir.</small>
            </div>
          </div>

          <button id="btnAgendar" class="btn-primary" type="button" onclick="agendar()">
            <i class="fa-solid fa-calendar-plus"></i>
            Agendar Mensagem
          </button>

          <p id="result"></p>
        </div>

        <div class="preview-card">
          <div class="preview-header">
            <i class="fa-solid fa-eye"></i> Prévia (estilo WhatsApp)
          </div>
          <div class="preview-chat">
            <div id="previewImage" class="chat-image" style="display:none;">
              <img src="" alt="arquivo de imagem">
            </div>
            <div id="previewFile" class="chat-file" style="display:none;">
              <i class="fa-solid fa-paperclip"></i>
              <span>Arquivo anexado</span>
            </div>
            <div class="chat-bubble">
              <span id="previewMessage">Sua mensagem aparecerá aqui</span>
              <span class="chat-time">agora</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de confirmação -->
  <div id="confirmModal" class="modal hidden">
    <div class="modal-content">
      <h3><i class="fa-solid fa-clipboard-check"></i> Confirmar agendamento</h3>
      <ul class="summary-list">
        <li><span>Data e hora:</span> <strong id="summary-datetime">—</strong></li>
        <li><span>Quantidade:</span> <strong id="summary-qty">—</strong></li>
        <li><span>Recorrência:</span> <strong id="summary-recurrence">—</strong></li>
        <li><span>Mensagem:</span> <strong id="summary-message">—</strong></li>
        <li><span>Personalizadas:</span> <strong id="summary-personalized">—</strong></li>
        <li><span>Arquivo:</span> <strong id="summary-file">—</strong></li>
      </ul>
      <div class="modal-actions">
        <button id="btnConfirmModal" class="btn-primary">
          <i class="fa-solid fa-check"></i> Confirmar e agendar
        </button>
        <button id="btnCancelModal" class="btn-secondary" type="button">
          <i class="fa-solid fa-circle-xmark"></i> Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal de detalhes -->
  <div id="detailsModal" class="modal hidden">
    <div class="modal-content">
      <h3><i class="fa-solid fa-list"></i> Histórico do agendamento</h3>
      <div id="detailsBody" class="details-body">Carregando...</div>
      <div class="modal-actions">
        <button class="btn-secondary" onclick="fecharDetalhes()">Fechar</button>
      </div>
    </div>
  </div>

  <script src="/js/loading-utils.js"></script>
  <script src="/js/toast.js"></script>
  <script>
    // ── Estado do arquivo selecionado ────────────────────────────────
    let selectedFileData = null; // { base64, filename, mimetype }
    let editingId = null;
    let existingFilename = null;
    let contactsData = [];
    const plan = "<%= (user.plan || 'starter').toLowerCase() %>";
    const MAX_NUMBERS = <%= Number(planConfig?.maxBroadcastNumbers ?? 50) %>;
    const WARN_THRESHOLD = 0.8; // 80%
    let agRows = [];
    let lastAgendaSnapshot = "";
    let lastAgendaRenderStateKey = "";
    let agPage = 1;
    let agTotalPages = 1;
    let calendarViewYear = 0;
    let calendarViewMonth = 0;
    let selectedDateKey = "";
    let USER_TZ = Number(document.body.dataset.userTz || -180); // minutos em relação ao UTC
    const PHONE_PREFIX = getConfiguredDefaultDdi();
    const PHONE_MIN_LENGTH = PHONE_PREFIX.length + 10;
    const PHONE_MAX_LENGTH = PHONE_PREFIX.length + 11;

    // Fallback de notify para esta página, caso não esteja carregado do layout
    function notify(msg, type = "info") {
      if (window.toastNotify) return window.toastNotify(msg, type);
      // fallback simples
      if (type === "error") alert("❌ " + msg);
      else if (type === "warning") alert("⚠️ " + msg);
      else alert(msg);
    }

    function setFormModalMeta(title, copy) {
      const titleEl = document.getElementById("formModalTitle");
      const copyEl = document.getElementById("formModalCopy");
      if (titleEl) {
        titleEl.innerHTML = title;
      }
      if (copyEl) {
        copyEl.textContent = copy;
      }
    }

    function openScheduleFormModal() {
      const modal = document.getElementById("scheduleFormModal");
      if (!modal) return;
      modal.classList.remove("hidden");
      modal.setAttribute("aria-hidden", "false");
    }

    function closeScheduleFormModal() {
      const modal = document.getElementById("scheduleFormModal");
      if (!modal) return;
      modal.classList.add("hidden");
      modal.setAttribute("aria-hidden", "true");
    }

    function resetScheduleComposer() {
      editingId = null;
      existingFilename = null;
      selectedFileData = null;
      contactsData = [];
      document.getElementById("nums").value = "";
      document.getElementById("msg").value = "";
      document.getElementById("sendAt").value = "";
      document.getElementById("recurrence").value = "none";
      document.getElementById("recurrenceEnd").value = "";
      clearFile();
      toggleRecurrenceEnd();
      updateNumCount();
      updatePreview();
      setResult("", true);
      document.getElementById("btnAgendar").innerHTML =
        '<i class="fa-solid fa-calendar-plus"></i> Agendar Mensagem';
      setFormModalMeta(
        '<i class="fa-solid fa-plus"></i> Novo agendamento',
        "Monte a mensagem, anexe mídia e confirme o horário sem sair da visão mensal do calendário."
      );
    }

    function prepareNewSchedule(dateKey = "") {
      resetScheduleComposer();

      if (dateKey) {
        const parts = parseDateKey(dateKey);
        if (parts) {
          const suggestedLocal = `${parts.year}-${pad2(parts.month + 1)}-${pad2(parts.day)}T09:00`;
          const suggestedUtc = toUtcFromInput(suggestedLocal, getTimezoneOffsetSelected());
          if (suggestedUtc <= Date.now()) {
            const suggested = new Date(Date.now() + 60 * 60 * 1000 + getTimezoneOffsetSelected() * 60000);
            document.getElementById("sendAt").value =
              `${suggested.getUTCFullYear()}-${pad2(suggested.getUTCMonth() + 1)}-${pad2(suggested.getUTCDate())}T${pad2(suggested.getUTCHours())}:${pad2(suggested.getUTCMinutes())}`;
          } else {
            document.getElementById("sendAt").value = suggestedLocal;
          }
        }
      }

      openScheduleFormModal();
    }

    function toggleRecurrenceEnd() {
      const rec = document.getElementById("recurrence")?.value || "none";
      const field = document.getElementById("recurrenceEndField");
      if (!field) return;
      field.style.display = rec === "none" ? "none" : "block";
    }

    async function salvarTimezone() {
      const sel = document.getElementById("timezoneSelect");
      if (!sel) return;
      const offset = Number(sel.value);
      try {
        const res = await fetch("/user/timezone", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ timezoneOffset: offset })
        });
        const data = await res.json();
        if (!res.ok || data?.ok === false) throw new Error(data?.error || "Erro ao salvar");
        USER_TZ = offset;
        notify("Fuso horário atualizado", "success");
        carregarAgendamentos({ selectedDate: selectedDateKey || getTodayDateKey() });
      } catch (err) {
        alert(err?.message || "Erro ao salvar fuso");
      }
    }

    function toUtcFromInput(inputStr, offsetMinutes) {
      // inputStr: "YYYY-MM-DDTHH:MM"
      const [datePart, timePart] = inputStr.split("T");
      const [year, month, day] = datePart.split("-").map(Number);
      const [hour, minute] = timePart.split(":").map(Number);
      const utcMs = Date.UTC(year, month - 1, day, hour, minute);
      return utcMs - offsetMinutes * 60000;
    }

    function fromUtcToInput(utcMs, offsetMinutes) {
      const localMs = utcMs + offsetMinutes * 60000;
      const d = new Date(localMs);
      const pad = (n) => String(n).padStart(2, "0");
      return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}T${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
    }

    function getTimezoneOffsetSelected() {
      return Number(document.getElementById("timezoneSelect")?.value || USER_TZ || -180);
    }

    function getConfiguredDefaultDdi() {
      const digits = String(document.body?.dataset?.defaultDdi || "55")
        .replace(/\D/g, "")
        .slice(0, 4);

      return digits || "55";
    }

    function pad2(value) {
      return String(value).padStart(2, "0");
    }

    function capitalizeLabel(value) {
      const text = String(value || "").trim();
      return text ? text.charAt(0).toUpperCase() + text.slice(1) : "";
    }

    function getLocalDateParts(ts, offsetMinutes = getTimezoneOffsetSelected()) {
      const safeTs = Number(ts || 0);
      const d = new Date(safeTs + offsetMinutes * 60000);
      const year = d.getUTCFullYear();
      const month = d.getUTCMonth();
      const day = d.getUTCDate();
      const hours = d.getUTCHours();
      const minutes = d.getUTCMinutes();

      return {
        year,
        month,
        day,
        hours,
        minutes,
        key: `${year}-${pad2(month + 1)}-${pad2(day)}`,
      };
    }

    function getTodayDateKey() {
      return getLocalDateParts(Date.now()).key;
    }

    function buildDateKey(year, month, day) {
      return `${year}-${pad2(month + 1)}-${pad2(day)}`;
    }

    function parseDateKey(dateKey) {
      const [year, month, day] = String(dateKey || "")
        .split("-")
        .map((part) => Number(part));
      if (!year || !month || !day) return null;
      return { year, month: month - 1, day };
    }

    function formatMonthLabel(year, month) {
      const date = new Date(Date.UTC(year, month, 1));
      return capitalizeLabel(
        new Intl.DateTimeFormat("pt-BR", {
          month: "long",
          year: "numeric",
          timeZone: "UTC",
        }).format(date)
      );
    }

    function formatDayHeaderLabel(dateKey) {
      const parts = parseDateKey(dateKey);
      if (!parts) return "Selecione um dia";
      const date = new Date(Date.UTC(parts.year, parts.month, parts.day));
      return capitalizeLabel(
        new Intl.DateTimeFormat("pt-BR", {
          weekday: "short",
          day: "numeric",
          month: "long",
          timeZone: "UTC",
        })
          .format(date)
          .replace(".", "")
      );
    }

    function getMonthRangeUtc(year, month, offsetMinutes = getTimezoneOffsetSelected()) {
      const lastDay = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
      return {
        fromTs: toUtcFromInput(`${year}-${pad2(month + 1)}-01T00:00`, offsetMinutes),
        toTs: toUtcFromInput(
          `${year}-${pad2(month + 1)}-${pad2(lastDay)}T23:59`,
          offsetMinutes
        ),
      };
    }

    function normalizeScheduledPhoneDigits(value, options = {}) {
      const digits = String(value || "").replace(/\D/g, "");
      if (!digits) return options.emptyAsPrefix ? PHONE_PREFIX : "";
      if (PHONE_PREFIX.startsWith(digits) && digits.length <= PHONE_PREFIX.length) {
        return PHONE_PREFIX;
      }

      const raw = digits.startsWith(PHONE_PREFIX) ? digits : `${PHONE_PREFIX}${digits}`;
      return raw.slice(0, PHONE_MAX_LENGTH);
    }

    function formatScheduledPhoneDigits(digits) {
      const normalized = normalizeScheduledPhoneDigits(digits, { emptyAsPrefix: true });
      const ddiLength = PHONE_PREFIX.length;
      const countryCode = normalized.slice(0, ddiLength);
      const ddd = normalized.slice(ddiLength, ddiLength + 2);
      const phone = normalized.slice(ddiLength + 2);

      let formatted = countryCode;
      if (ddd) {
        formatted += ` (${ddd}`;
        if (ddd.length === 2) formatted += ")";
      }
      if (phone) {
        formatted += ` ${formatScheduledPhoneLocal(phone)}`;
      }
      return formatted;
    }

    function formatScheduledPhoneLocal(phone) {
      if (phone.length <= 4) return phone;
      if (phone.length <= 8) {
        return `${phone.slice(0, 4)}-${phone.slice(4)}`;
      }
      return `${phone.slice(0, 5)}-${phone.slice(5, 9)}`;
    }

    function formatPhoneDisplay(value) {
      const digits = String(value || "").replace(/\D/g, "");
      if (!digits) return "—";
      if (digits.length > PHONE_MAX_LENGTH && !digits.startsWith(PHONE_PREFIX)) {
        return digits;
      }
      return formatScheduledPhoneDigits(digits);
    }

    function formatPhoneLine(line) {
      const digits = normalizeScheduledPhoneDigits(line, { emptyAsPrefix: false });
      if (!digits) return "";
      return formatScheduledPhoneDigits(digits);
    }

    function normalizeContactsList(list) {
      return Array.isArray(list)
        ? list
            .map((item) => {
              if (!item || typeof item !== "object") return null;
              const number = normalizeScheduledPhoneDigits(item.number || "", { emptyAsPrefix: false });
              if (!number) return null;
              return {
                ...item,
                number,
              };
            })
            .filter(Boolean)
        : [];
    }

    function getTextareaCaretMeta(value, position) {
      const before = String(value || "").slice(0, Number(position || 0));
      const parts = before.split("\n");
      return {
        lineIndex: parts.length - 1,
        digitCount: String(parts[parts.length - 1] || "").replace(/\D/g, "").length,
      };
    }

    function getPositionAfterDigits(line, digitCount) {
      if (!digitCount) return 0;

      let seen = 0;
      for (let i = 0; i < line.length; i++) {
        if (/\d/.test(line[i])) seen++;
        if (seen >= digitCount) return i + 1;
      }
      return line.length;
    }

    function getTextareaCaretPosition(lines, meta) {
      const safeLineIndex = Math.max(0, Math.min(meta.lineIndex, Math.max(lines.length - 1, 0)));
      let absolute = 0;

      for (let i = 0; i < safeLineIndex; i++) {
        absolute += String(lines[i] || "").length + 1;
      }

      return absolute + getPositionAfterDigits(String(lines[safeLineIndex] || ""), meta.digitCount);
    }

    function applyNumsMask() {
      const textarea = document.getElementById("nums");
      if (!textarea) return;

      const rawValue = String(textarea.value || "");
      const startMeta = getTextareaCaretMeta(rawValue, textarea.selectionStart);
      const endMeta = getTextareaCaretMeta(rawValue, textarea.selectionEnd);
      const formattedLines = rawValue.split("\n").map(formatPhoneLine);
      const formattedValue = formattedLines.join("\n");

      if (formattedValue !== rawValue) {
        textarea.value = formattedValue;
      }

      const start = getTextareaCaretPosition(formattedLines, startMeta);
      const end = getTextareaCaretPosition(formattedLines, endMeta);
      textarea.setSelectionRange(start, end);
    }

    function ensureNumsPrefixOnFocus() {
      const textarea = document.getElementById("nums");
      if (!textarea) return;
      if (!textarea.value.trim()) {
        textarea.value = PHONE_PREFIX;
        textarea.setSelectionRange(textarea.value.length, textarea.value.length);
      }
      applyNumsMask();
    }

    function handleNumsKeydown(event) {
      if (event.key !== "Enter") return;
      const textarea = document.getElementById("nums");
      if (!textarea) return;

      event.preventDefault();
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const value = textarea.value;
      const insertion = `\n${PHONE_PREFIX}`;

      textarea.value = `${value.slice(0, start)}${insertion}${value.slice(end)}`;
      const caret = start + insertion.length;
      textarea.setSelectionRange(caret, caret);
      updateNumCount();
      updatePreview();
    }

    function handleNumsInput() {
      applyNumsMask();
      updateNumCount();
      updatePreview();
    }

    // ── Contador de números ────────────────────────────────
    function updateNumCount() {
      const nums = document.getElementById("nums").value
        .split("\n").map(n => n.trim()).filter(Boolean);
      const el = document.getElementById("num-count");
      if (el) {
        const used = contactsData.length ? contactsData.length : nums.length;
        const remaining = Math.max(MAX_NUMBERS - used, 0);
        const pct = used / MAX_NUMBERS;
        let cls = "ok";
        if (used > MAX_NUMBERS) cls = "danger";
        else if (pct >= WARN_THRESHOLD) cls = "warn";
        el.className = `field-hint limit-${cls}`;
        const personalizedTag = contactsData.length ? " • mensagens personalizadas" : "";
        el.innerHTML = `${used} número(s) • limite ${MAX_NUMBERS} • restantes ${remaining}${personalizedTag}`;
      }
    }

    // ── Seleção de arquivo ────────────────────────────────
    function handleFileSelect(input) {
      const file = input.files[0];
      if (!file) return;

      const maxMB = 15;
      if (file.size > maxMB * 1024 * 1024) {
        alert("Arquivo muito grande. Máximo: " + maxMB + "MB");
        input.value = "";
        return;
      }

      const reader = new FileReader();
      reader.onload = (e) => {
        const dataUrl = e.target.result;
        existingFilename = null;

        // Imagem → comprimir via canvas
        if (file.type.startsWith("image/")) {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement("canvas");
            const MAX = 1280;
            let w = img.width, h = img.height;
            if (w > MAX || h > MAX) {
              if (w > h) { h = Math.round(h * MAX / w); w = MAX; }
              else       { w = Math.round(w * MAX / h); h = MAX; }
            }
            canvas.width = w; canvas.height = h;
            canvas.getContext("2d").drawImage(img, 0, 0, w, h);
            const compressed = canvas.toDataURL("image/jpeg", 0.85);
            const base64 = compressed.split(",")[1];
            selectedFileData = {
              base64,
              filename: file.name.replace(/\.[^.]+$/, ".jpg"),
              mimetype: "image/jpeg"
            };
            showFilePreview(compressed, null);
            updatePreview();
          };
          img.src = dataUrl;
        } else {
          // Outros arquivos — enviar direto
          const base64 = dataUrl.split(",")[1];
          selectedFileData = { base64, filename: file.name, mimetype: file.type };
          showFilePreview(null, file.name);
          updatePreview();
        }
      };
      reader.readAsDataURL(file);
      input.value = ""; // resetar para permitir re-seleção
    }

    function showFilePreview(imgSrc, docName) {
      const area      = document.getElementById("filePreview");
      const img       = document.getElementById("previewImg");
      const doc       = document.getElementById("previewDoc");
      const docNameEl = document.getElementById("previewDocName");
      const uploadArea = document.getElementById("fileUploadArea");

      area.style.display = "flex";
      uploadArea.style.display = "none";

      if (imgSrc) {
        img.src = imgSrc;
        img.style.display = "block";
        doc.style.display = "none";
      } else {
        img.style.display = "none";
        doc.style.display = "flex";
        docNameEl.textContent = docName;
      }
    }

    function clearFile() {
      selectedFileData = null;
      existingFilename = null;
      document.getElementById("filePreview").style.display = "none";
      document.getElementById("fileUploadArea").style.display = "flex";
      document.getElementById("previewImg").src = "";
      document.getElementById("previewImg").style.display = "none";
      document.getElementById("previewDoc").style.display = "none";
      updatePreview();
    }

    function getPreviewContext() {
      const now = new Date();
      const dataHoje = now.toLocaleDateString("pt-BR");
      const horaAgora = now.toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });

      if (contactsData.length) {
        const first = contactsData[0];
        const vars = first?.vars || {};
        return {
          numero: formatPhoneDisplay(first.number || `${PHONE_PREFIX}999990000`),
          nome: vars.nome || vars.name || "Maria",
          pedido: vars.pedido || vars.order || "#12345",
          data: dataHoje,
          hora: horaAgora,
          ...vars,
        };
      }

      return {
        numero: formatPhoneDisplay(`${PHONE_PREFIX}999990000`),
        nome: "Maria",
        pedido: "#12345",
        data: dataHoje,
        hora: horaAgora,
      };
    }

    function renderTemplatePreview(template) {
      if (!template) return "";
      const ctx = getPreviewContext();
      const mapKeys = {
        numero: ctx.numero,
        number: ctx.numero,
        nome: ctx.nome,
        name: ctx.nome,
        pedido: ctx.pedido,
        order: ctx.pedido,
        data: ctx.data,
        data_atual: ctx.data,
        hoje: ctx.data,
        hora: ctx.hora,
        horario: ctx.hora,
        time: ctx.hora,
        date: ctx.data,
      };

      return template.replace(/{{\s*([\w.-]+)\s*}}/gi, (_m, keyRaw) => {
        const key = String(keyRaw || "").toLowerCase();
        if (mapKeys[key] !== undefined) return mapKeys[key];
        if (ctx[key] !== undefined) return ctx[key];
        return "";
      });
    }

    // ── Prévia estilo WhatsApp ────────────────────────────
    function updatePreview() {
      const msg = document.getElementById("msg").value || "";
      const templated = renderTemplatePreview(msg);
      const previewMessage = document.getElementById("previewMessage");
      const previewImage = document.getElementById("previewImage");
      const previewFile = document.getElementById("previewFile");

      const safe = templated
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\n/g, "<br>");
      previewMessage.innerHTML = safe || "Sua mensagem aparecerá aqui";

      if (selectedFileData) {
        previewFile.style.display = "flex";

        if (selectedFileData.mimetype?.startsWith("image/")) {
          const imgEl = previewImage.querySelector("img");
          imgEl.src = `data:${selectedFileData.mimetype};base64,${selectedFileData.base64}`;
          previewImage.style.display = "block";
        } else {
          previewImage.style.display = "none";
        }
      } else {
        previewFile.style.display = "none";
        previewImage.style.display = "none";
      }
    }

    // ── Importar CSV de números ────────────────────────────
    function importarCSV(input) {
      const file = input.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const text = (e.target?.result || "").toString().replace(/\r/g, "\n");
        const delim = text.includes(";") && text.split(";").length >= text.split(",").length
          ? ";"
          : text.includes("\t")
            ? "\t"
            : ",";

        const lines = text.split("\n").filter(Boolean);
        if (!lines.length) return alert("Nenhum dado encontrado.");

        const headers = lines[0].split(delim).map(h => h.trim().toLowerCase());
        const idxNum = headers.findIndex(h => ["numero","número","number","phone","telefone"].includes(h));
        const idxMsg = headers.findIndex(h => ["mensagem","message","msg","texto"].includes(h));

        let parsed = [];
        if (idxNum >= 0) {
          for (let i = 1; i < lines.length; i++) {
            const cols = lines[i].split(delim);
            const num = normalizeScheduledPhoneDigits(cols[idxNum] || "", { emptyAsPrefix: false });
            if (!num) continue;
            const msg = idxMsg >= 0 ? (cols[idxMsg] || "") : "";

            const vars = {};
            headers.forEach((h, idx) => {
              if (idx === idxNum || idx === idxMsg) return;
              const key = h.replace(/[^a-z0-9_]+/g, "_");
              const val = cols[idx] || "";
              if (key && val) vars[key] = val;
            });

            parsed.push({ number: num, message: msg, vars: Object.keys(vars).length ? vars : undefined });
          }
        }

        // fallback para lista simples
        if (!parsed.length) {
          const tokens = text
            .split(/[\n;,]+/)
            .map(t => t.trim())
            .filter(Boolean);
          parsed = tokens.map(t => ({
              number: normalizeScheduledPhoneDigits(t, { emptyAsPrefix: false }),
              message: ""
            }))
            .filter(p => p.number);
        }

        if (!parsed.length) {
          alert("Nenhum número encontrado no CSV.");
          return;
        }

        contactsData = parsed;
        const textarea = document.getElementById("nums");
        textarea.value = parsed.map(p => formatPhoneDisplay(p.number)).join("\n");
        updateNumCount();
        updatePreview();
      };
      reader.readAsText(file, "utf-8");
      input.value = "";
    }

    // ── Agendar ────────────────────────────────
    async function agendar() {
      clearAllFieldErrors();
      const numbers = document.getElementById("nums").value
        .split("\n")
        .map((n) => normalizeScheduledPhoneDigits(n, { emptyAsPrefix: false }))
        .filter(Boolean);
      const totalCount = contactsData.length ? contactsData.length : numbers.length;

      if (!numbers.length && !contactsData.length) {
        setResult("Informe pelo menos um número", false);
        showFieldError("nums", "Informe pelo menos um número ou importe CSV.");
        return;
      }
      if (totalCount > MAX_NUMBERS) {
        setResult(`Limite do plano: máximo ${MAX_NUMBERS} números`, false);
        showFieldError("nums", `Limite do plano: máximo ${MAX_NUMBERS} números.`);
        return;
      }

      const sendAtVal = document.getElementById("sendAt").value;
      if (!sendAtVal) {
        setResult("Informe a data e hora do envio", false);
        showFieldError("sendAt", "Informe a data e hora do envio.");
        return;
      }

      const tzOffset = getTimezoneOffsetSelected();
      const sendAt = toUtcFromInput(sendAtVal, tzOffset);
      if (sendAt <= Date.now()) {
        setResult("A data deve ser no futuro", false);
        showFieldError("sendAt", "Escolha um horário no futuro.");
        return;
      }

      const recurrence = document.getElementById("recurrence").value || "none";
      const recurrenceEndVal = document.getElementById("recurrenceEnd")?.value || "";
      if (recurrence !== "none" && recurrenceEndVal) {
        const endTs = toUtcFromInput(recurrenceEndVal + "T23:59", tzOffset);
        if (!Number.isFinite(endTs) || endTs <= sendAt) {
          setResult("Encerramento da recorrência deve ser após a primeira data.", false);
          showFieldError("recurrenceEnd", "Encerramento deve ser depois da primeira data.");
          return;
        }
      }

      const message = document.getElementById("msg").value;
      if (!message && !selectedFileData) {
        setResult("Informe uma mensagem ou selecione um arquivo", false);
        showFieldError("msg", "Informe mensagem ou anexe um arquivo.");
        return;
      }

      const payload = {
        numbers,
        contacts: contactsData.length ? normalizeContactsList(contactsData) : undefined,
        message,
        sendAt,
        recurrence: document.getElementById("recurrence").value || "none",
        recurrenceEnd: (document.getElementById("recurrenceEnd")?.value || "")
          ? toUtcFromInput(document.getElementById("recurrenceEnd").value + "T23:59", tzOffset)
          : null,
        file:     selectedFileData ? `data:${selectedFileData.mimetype};base64,${selectedFileData.base64}` : null,
        filename: selectedFileData?.filename || null
      };

      showConfirmModal(payload);
    }

    function editar(id) {
      const row = agRows.find(r => Number(r.id) === Number(id));
      if (!row) return;
      editingId = id;
      existingFilename = row.filename || null;
      selectedFileData = null;

      // Preenche campos
      const nums = JSON.parse(row.numbers || "[]");
      const hasPersonalized = Array.isArray(nums) && nums.length && typeof nums[0] === "object";
      contactsData = hasPersonalized ? normalizeContactsList(nums) : [];
      document.getElementById("nums").value = nums
        .map((n) => formatPhoneDisplay(typeof n === "object" ? n.number : n))
        .join("\n");
      document.getElementById("msg").value = row.message || "";
      const dtStr = fromUtcToInput(row.send_at, getTimezoneOffsetSelected());
      document.getElementById("sendAt").value = dtStr;
      document.getElementById("recurrence").value = row.recurrence || "none";
      if (row.recurrence_end) {
        const endDateStr = fromUtcToInput(Number(row.recurrence_end), getTimezoneOffsetSelected()).slice(0,10);
        document.getElementById("recurrenceEnd").value = endDateStr;
      } else {
        document.getElementById("recurrenceEnd").value = "";
      }
      toggleRecurrenceEnd();

      // Preview do arquivo existente (apenas nome)
      if (row.filename) {
        document.getElementById("filePreview").style.display = "flex";
        document.getElementById("fileUploadArea").style.display = "none";
        document.getElementById("previewImg").style.display = "none";
        const doc = document.getElementById("previewDoc");
        doc.style.display = "flex";
        document.getElementById("previewDocName").textContent = row.filename;
        selectedFileData = null; // mantém arquivo atual a menos que reenvie
      } else {
        clearFile();
      }

      // UI
      setResult("Editando agendamento pendente #" + id, true);
      document.getElementById("btnAgendar").innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Salvar alterações';
      setFormModalMeta(
        '<i class="fa-solid fa-pen"></i> Editar agendamento',
        "Ajuste mensagem, horário ou recorrência e salve sem perder o contexto do calendário."
      );

      updateNumCount();
      updatePreview();
      openScheduleFormModal();
    }

    function duplicar(id, options = {}) {
      const row = agRows.find(r => Number(r.id) === Number(id));
      if (!row) return;
      editingId = null; // novo
      existingFilename = row.filename || null;
      selectedFileData = null;

      // Números
      try {
        const nums = JSON.parse(row.numbers || "[]");
        const hasPersonalized = Array.isArray(nums) && nums.length && typeof nums[0] === "object";
        contactsData = hasPersonalized ? normalizeContactsList(nums) : [];
        document.getElementById("nums").value = nums
          .map((n) => formatPhoneDisplay(typeof n === "object" ? n.number : n))
          .join("\n");
      } catch {
        contactsData = [];
        document.getElementById("nums").value = "";
      }

      // Mensagem
      document.getElementById("msg").value = row.message || "";

      // Recorrência
      document.getElementById("recurrence").value = row.recurrence || "none";
      if (row.recurrence_end) {
        document.getElementById("recurrenceEnd").value = fromUtcToInput(
          Number(row.recurrence_end),
          getTimezoneOffsetSelected()
        ).slice(0, 10);
      } else {
        document.getElementById("recurrenceEnd").value = "";
      }
      toggleRecurrenceEnd();

      // Data/hora: usa sugestão rápida quando existir
      if (options.suggestedSendAtMs) {
        document.getElementById("sendAt").value = fromUtcToInput(
          Number(options.suggestedSendAtMs),
          getTimezoneOffsetSelected()
        );
      } else {
        document.getElementById("sendAt").value = "";
      }

      // Preview de arquivo (mantém nome se existir)
      if (row.filename) {
        document.getElementById("filePreview").style.display = "flex";
        document.getElementById("fileUploadArea").style.display = "none";
        document.getElementById("previewImg").style.display = "none";
        const doc = document.getElementById("previewDoc");
        doc.style.display = "flex";
        document.getElementById("previewDocName").textContent = row.filename;
      } else {
        clearFile();
      }

      setResult(
        options.notice || `Duplicando agendamento #${id}. Ajuste data/hora e salve.`,
        true
      );
      document.getElementById("btnAgendar").innerHTML =
        options.buttonLabel || '<i class="fa-solid fa-calendar-plus"></i> Criar agendamento';
      setFormModalMeta(
        '<i class="fa-solid fa-copy"></i> Duplicar envio',
        "Revise os contatos, confirme a nova data e crie uma nova cópia deste agendamento."
      );

      updateNumCount();
      updatePreview();
      openScheduleFormModal();
    }

    function scrollToScheduleForm() {
      prepareNewSchedule(selectedDateKey);
    }

    function setStatusFilterQuick(status) {
      const select = document.getElementById("statusFilter");
      if (!select) return;
      select.value = status;
      syncStatusChipUI();
      resetPageAndLoad();
    }

    function syncStatusChipUI() {
      const activeStatus = document.getElementById("statusFilter")?.value || "all";
      document.querySelectorAll("[data-status-chip]").forEach((button) => {
        button.classList.toggle("is-active", button.dataset.statusChip === activeStatus);
      });
    }

    function prepareQuickResend(id, mode = "resend") {
      const delayMinutes = mode === "retry" ? 3 : 5;
      const suggestedSendAtMs = Date.now() + delayMinutes * 60 * 1000;
      duplicar(id, {
        suggestedSendAtMs,
        notice:
          mode === "retry"
            ? `Agendamento #${id} preparado para nova tentativa. Revise e confirme no formulário.`
            : `Agendamento #${id} preparado para reenvio. Revise e confirme no formulário.`,
        buttonLabel: '<i class="fa-solid fa-calendar-plus"></i> Criar agendamento',
      });
    }

    function cancelarAgendamento(id) {
      return excluir(id, {
        confirmText: "Cancelar este agendamento pendente?",
        successText: "Agendamento cancelado.",
      });
    }

    function showConfirmModal(payload) {
      const modal = document.getElementById("confirmModal");
      document.getElementById("summary-datetime").textContent = formatDateTime(payload.sendAt);
      const qty = contactsData.length ? contactsData.length : payload.numbers.length;
      document.getElementById("summary-qty").textContent = `${qty} número(s)`;
      document.getElementById("summary-recurrence").textContent = (payload.recurrence || "none").toUpperCase();
      document.getElementById("summary-message").textContent = payload.message ? truncate(payload.message, 120) : "—";
      const fileLabel = payload.filename
        || (payload.file ? "Arquivo novo" : null)
        || (existingFilename ? `Mantém: ${existingFilename}` : "Nenhum");
      document.getElementById("summary-file").textContent = fileLabel;
      const hasPersonalized = contactsData.length > 0;
      const personalizedLine = document.getElementById("summary-personalized");
      if (personalizedLine) {
        personalizedLine.textContent = hasPersonalized ? "Sim (mensagem por contato)" : "Não";
      }

      modal.classList.remove("hidden");

      const confirmBtn = document.getElementById("btnConfirmModal");
      const cancelBtn = document.getElementById("btnCancelModal");
      confirmBtn.innerHTML = editingId
        ? '<i class="fa-solid fa-floppy-disk"></i> Salvar alterações'
        : '<i class="fa-solid fa-check"></i> Confirmar e agendar';

      const onConfirm = () => {
        modal.classList.add("hidden");
        confirmBtn.removeEventListener("click", onConfirm);
        cancelBtn.removeEventListener("click", onCancel);
        submitAgendamento(payload);
      };
      const onCancel = () => {
        modal.classList.add("hidden");
        confirmBtn.removeEventListener("click", onConfirm);
        cancelBtn.removeEventListener("click", onCancel);
      };

      confirmBtn.addEventListener("click", onConfirm);
      cancelBtn.addEventListener("click", onCancel);
    }

    function truncate(text, max) {
      if (!text) return "";
      return text.length > max ? text.slice(0, max) + "…" : text;
    }

    function formatDateTime(ts) {
      const d = new Date(ts + getTimezoneOffsetSelected() * 60000);
      const pad = (n) => String(n).padStart(2, "0");
      return `${pad(d.getUTCDate())}/${pad(d.getUTCMonth() + 1)}/${d.getUTCFullYear()} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
    }

    async function submitAgendamento(payload) {
      const btnEl = document.getElementById("btnAgendar");
      btnEl.disabled = true;
      btnEl.innerHTML = editingId
        ? '<i class="fa-solid fa-spinner fa-spin"></i> Salvando...'
        : '<i class="fa-solid fa-spinner fa-spin"></i> Agendando...';

      // manter arquivo atual se não enviar um novo
      if (editingId && !selectedFileData && existingFilename) {
        payload.keepExistingFile = true;
        payload.file = null;
        payload.filename = null;
      }
      const url = editingId
        ? `/api/agendamentos/update/${editingId}`
        : "/api/agendamentos/create";
      const method = editingId ? "PUT" : "POST";

      try {
        const res = await fetch(url, {
          method,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        const warnings = Array.isArray(data?.warnings)
          ? data.warnings.filter((warning) => typeof warning === "string" && warning.trim())
          : [];
        const skippedCount = Array.isArray(data?.skipped)
          ? data.skipped.length
          : Number(data?.skipped || 0);

        if (data.ok) {
          const savedDateKey = getLocalDateParts(payload.sendAt).key;
          const savedDateParts = getLocalDateParts(payload.sendAt);
          calendarViewYear = savedDateParts.year;
          calendarViewMonth = savedDateParts.month;
          selectedDateKey = savedDateKey;
          setResult(editingId ? "✅ Agendamento atualizado!" : "✅ Agendamento criado com sucesso!", true);
          warnings.forEach((warning) => notify(warning, "warning"));
          if (skippedCount > 0) {
            notify(`${skippedCount} contato(s) foram removidos pelas regras de seguranca.`, "warning");
          }
          closeScheduleFormModal();
          resetScheduleComposer();
          carregarAgendamentos({ selectedDate: savedDateKey });
        } else {
          warnings.forEach((warning) => notify(warning, "warning"));
          if (skippedCount > 0) {
            notify(`${skippedCount} contato(s) foram removidos pelas regras de seguranca.`, "warning");
          }
          setResult("❌ " + (data.error || "Erro ao agendar"), false);
          btnEl.innerHTML = '<i class="fa-solid fa-calendar-plus"></i> Agendar Mensagem';
        }
      } catch {
        setResult("❌ Erro de conexão", false);
        btnEl.innerHTML = '<i class="fa-solid fa-calendar-plus"></i> Agendar Mensagem';
      } finally {
        btnEl.disabled = false;
      }
    }

    function setResult(msg, ok) {
      const el = document.getElementById("result");
      el.textContent = msg;
      el.style.color = ok ? "#2ee6a6" : "#e54848";
    }

    // ── Excluir / cancelar ────────────────────────────────────────
    async function excluir(id, options = {}) {
      if (!confirm(options.confirmText || "Excluir este agendamento?")) return;

      try {
        const res = await fetch(`/api/agendamentos/delete/${id}`, { method: "DELETE" });
        const data = await res.json().catch(() => ({ ok: res.ok }));
        if (!res.ok || data?.ok === false) {
          throw new Error(data?.error || "Não foi possível remover o agendamento.");
        }
        if (options.successText) {
          notify(options.successText, "success");
        }
        carregarAgendamentos();
      } catch (err) {
        notify(err?.message || "Erro ao remover agendamento.", "error");
      }
    }

    function escapeHtml(text) {
      return String(text ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function readScheduleEntries(row) {
      try {
        const parsed = JSON.parse(row?.numbers || "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    function getSchedulePrimaryLabel(entries) {
      if (!entries.length) return "Sem destinatários";
      const first = entries[0];
      const name =
        typeof first === "object"
          ? String(first?.vars?.nome || first?.vars?.name || "").trim()
          : "";
      const number = typeof first === "object" ? first?.number : first;
      const baseLabel = name || formatPhoneDisplay(number);
      return entries.length > 1 ? `${baseLabel} +${entries.length - 1}` : baseLabel;
    }

    function formatRelativeDateLabel(ts) {
      const offset = getTimezoneOffsetSelected();
      const target = new Date(Number(ts) + offset * 60000);
      const now = new Date(Date.now() + offset * 60000);

      const targetDay = Date.UTC(target.getUTCFullYear(), target.getUTCMonth(), target.getUTCDate());
      const todayDay = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
      const diffDays = Math.round((targetDay - todayDay) / 86400000);
      const time = `${String(target.getUTCHours()).padStart(2, "0")}:${String(target.getUTCMinutes()).padStart(2, "0")}`;

      if (diffDays === 0) return `Hoje ${time}`;
      if (diffDays === 1) return `Amanhã ${time}`;
      if (diffDays === -1) return `Ontem ${time}`;
      return `${String(target.getUTCDate()).padStart(2, "0")}/${String(target.getUTCMonth() + 1).padStart(2, "0")} ${time}`;
    }

    function getStatusMeta(status) {
      switch (status) {
        case "pending":
          return { label: "Pendente", tone: "pending" };
        case "processing":
          return { label: "Em envio", tone: "processing" };
        case "failed":
          return { label: "Falha", tone: "failed" };
        default:
          return { label: "Enviado", tone: "sent" };
      }
    }

    function buildScheduleMetaPills(row, entries) {
      const totalContacts = entries.length;
      const personalizedCount = entries.filter((entry) => typeof entry === "object").length;
      const pills = [
        `<span class="schedule-meta-pill"><i class="fa-solid fa-users"></i>${totalContacts} contato(s)</span>`,
        `<span class="schedule-meta-pill"><i class="fa-solid fa-clock"></i>${escapeHtml(formatRelativeDateLabel(row.send_at))}</span>`,
      ];

      if (row.recurrence && row.recurrence !== "none") {
        pills.push(
          `<span class="schedule-meta-pill"><i class="fa-solid fa-rotate"></i>${escapeHtml(
            formatarRecorrencia(row.recurrence)
          )}</span>`
        );
      }

      if (row.status === "pending") {
        pills.push(
          `<span class="schedule-meta-pill countdown" data-send="${row.send_at}" data-status="${row.status}">
            ${escapeHtml(formatarCountdown(row.send_at))}
          </span>`
        );
      } else if (row.status === "processing") {
        pills.push(`<span class="schedule-meta-pill"><i class="fa-solid fa-spinner"></i>Em processamento</span>`);
      } else if (Number(row.last_log_sent_at || 0) > 0) {
        const success = Number(row.last_log_success_count || 0);
        const failure = Number(row.last_log_failure_count || 0);
        pills.push(
          `<span class="schedule-meta-pill"><i class="fa-solid fa-chart-simple"></i>${success} ok • ${failure} falha(s)</span>`
        );
      }

      if (personalizedCount > 0) {
        pills.push(`<span class="pill-personalized">${personalizedCount} com mensagem personalizada</span>`);
      }

      if (row.filename) {
        pills.push(
          `<span class="schedule-meta-pill"><i class="fa-solid fa-paperclip"></i>${escapeHtml(
            row.filename
          )}</span>`
        );
      }

      return pills.join("");
    }

    function buildScheduleActions(row) {
      if (row.status === "pending") {
        return `
          <button class="btn-quick primary" type="button" onclick="editar(${row.id})">
            <i class="fa-solid fa-pen"></i> Editar
          </button>
          <button class="btn-quick danger" type="button" onclick="cancelarAgendamento(${row.id})">
            <i class="fa-solid fa-ban"></i> Cancelar
          </button>
        `;
      }

      if (row.status === "failed") {
        return `
          <button class="btn-quick warn" type="button" onclick="prepareQuickResend(${row.id}, 'retry')">
            <i class="fa-solid fa-rotate-right"></i> Tentar novamente
          </button>
          <button class="btn-quick" type="button" onclick="verDetalhes(${row.id})">
            <i class="fa-solid fa-list"></i> Ver falha
          </button>
        `;
      }

      return `
        <button class="btn-quick success" type="button" onclick="prepareQuickResend(${row.id}, 'resend')">
          <i class="fa-solid fa-paper-plane"></i> Reenviar
        </button>
        <button class="btn-quick" type="button" onclick="verDetalhes(${row.id})">
          <i class="fa-solid fa-list"></i> Detalhes
        </button>
      `;
    }

    function renderStatusCounts(counts = {}) {
      const normalized = {
        all: Number(counts?.all || 0),
        pending: Number(counts?.pending || 0),
        processing: Number(counts?.processing || 0),
        sent: Number(counts?.sent || 0),
        failed: Number(counts?.failed || 0),
      };

      const allCount = normalized.all || normalized.pending + normalized.processing + normalized.sent + normalized.failed;
      document.getElementById("statusCountAll").textContent = String(allCount);
      document.getElementById("statusCountPending").textContent = String(normalized.pending);
      document.getElementById("statusCountSent").textContent = String(normalized.sent);
      document.getElementById("statusCountFailed").textContent = String(normalized.failed);
      document.getElementById("statusCountProcessing").textContent = String(normalized.processing);

      const processingChip = document.getElementById("statusChipProcessing");
      const selectedStatus = document.getElementById("statusFilter")?.value || "all";
      if (processingChip) {
        processingChip.hidden = normalized.processing === 0 && selectedStatus !== "processing";
      }
    }

    function updateListSummary(status, payload, term) {
      const countEl = document.getElementById("agSummaryCount");
      const hintEl = document.getElementById("agSummaryHint");
      if (!countEl || !hintEl) return;

      const total = Number(payload?.total || 0);
      const labelMap = {
        all: "agendamentos",
        pending: "pendente(s)",
        processing: "em envio",
        sent: "enviado(s)",
        failed: "com falha",
      };

      countEl.textContent = `${total} ${labelMap[status] || "agendamentos"}`;

      if (term) {
        hintEl.textContent = `Mostrando resultados para "${term}".`;
        return;
      }

      if (status === "failed") {
        hintEl.textContent = "Falhas mostram o último erro e um atalho para nova tentativa.";
      } else if (status === "sent") {
        hintEl.textContent = "Use reenviar para subir uma nova cópia no formulário sem sair da página.";
      } else if (status === "pending") {
        hintEl.textContent = "Pendentes podem ser editados ou cancelados diretamente na lista.";
      } else {
        hintEl.textContent = "Use os chips para focar em pendentes, enviados ou falhas.";
      }
    }

    function renderScheduleCard(row) {
      const entries = readScheduleEntries(row);
      const statusMeta = getStatusMeta(row.status);
      const primaryLabel = getSchedulePrimaryLabel(entries);
      const subtitle = row.last_log_sent_at
        ? `Última execução em ${escapeHtml(formatarData(row.last_log_sent_at))}`
        : `Programado para ${escapeHtml(formatarData(row.send_at))}`;
      const messageText = row.message
        ? escapeHtml(truncate(row.message, 180))
        : `<i>${escapeHtml(row.filename ? `Arquivo: ${row.filename}` : "(arquivo)")}</i>`;
      const errorHtml = row.last_error
        ? `<div class="schedule-error-inline"><i class="fa-solid fa-triangle-exclamation"></i>${escapeHtml(
            truncate(row.last_error, 160)
          )}</div>`
        : "";

      return `
        <article class="schedule-card status-${statusMeta.tone}">
          <div class="schedule-card-main">
            <span class="schedule-dot ${statusMeta.tone}"></span>
            <div class="schedule-copy">
              <div class="schedule-topline">
                <strong class="schedule-title">${escapeHtml(primaryLabel)}</strong>
                <span class="schedule-status-badge ${statusMeta.tone}">${escapeHtml(statusMeta.label)}</span>
              </div>
              <div class="schedule-subline">${subtitle}</div>
              <div class="schedule-message">${messageText}</div>
              <div class="schedule-meta-row">
                ${buildScheduleMetaPills(row, entries)}
              </div>
              ${errorHtml}
            </div>
          </div>

          <div class="schedule-actions">
            ${buildScheduleActions(row)}
          </div>
        </article>
      `;
    }

    function renderEmptySchedules(status, term) {
      const title = term
        ? "Nenhum resultado encontrado"
        : status === "failed"
          ? "Nenhuma falha por aqui"
          : status === "sent"
            ? "Nenhum envio encontrado"
            : status === "pending"
              ? "Nenhum pendente encontrado"
              : "Nenhum agendamento criado";
      const description = term
        ? "Ajuste a busca ou limpe os filtros para ver outros resultados."
        : "Assim que você criar ou processar agendamentos, eles aparecerão aqui com status e ações rápidas.";

      return `
        <div class="empty-schedule-state">
          <strong>${escapeHtml(title)}</strong>
          <span>${escapeHtml(description)}</span>
        </div>
      `;
    }

    function normalizeScheduleStatus(status) {
      const normalized = String(status || "").toLowerCase();
      if (["pending", "processing", "sent", "failed"].includes(normalized)) {
        return normalized;
      }
      return "sent";
    }

    function getCountsFromRows(rows = []) {
      const counts = {
        all: 0,
        pending: 0,
        processing: 0,
        sent: 0,
        failed: 0,
      };

      rows.forEach((row) => {
        const key = normalizeScheduleStatus(row?.status);
        counts[key] += 1;
        counts.all += 1;
      });

      return counts;
    }

    function searchMatchesRow(row, term) {
      if (!term) return true;
      const lowered = String(term || "").trim().toLowerCase();
      if (!lowered) return true;

      const entries = readScheduleEntries(row);
      const primaryLabel = getSchedulePrimaryLabel(entries).toLowerCase();
      const numbersRaw = Array.isArray(entries)
        ? entries
            .map((entry) => {
              if (typeof entry === "object") {
                return `${entry.number || ""} ${JSON.stringify(entry.vars || {})}`;
              }
              return String(entry || "");
            })
            .join(" ")
        : "";
      const haystack = [
        row?.message || "",
        row?.filename || "",
        row?.numbers || "",
        primaryLabel,
        numbersRaw,
      ]
        .join(" ")
        .toLowerCase();

      return haystack.includes(lowered);
    }

    function getRowsForDate(dateKey) {
      return agRows
        .filter((row) => getLocalDateParts(row.send_at).key === dateKey)
        .sort((a, b) => Number(a.send_at || 0) - Number(b.send_at || 0));
    }

    function getFilteredDayRows(dateKey) {
      const status = document.getElementById("statusFilter")?.value || "all";
      const term = (document.getElementById("searchTerm")?.value || "").trim();

      return getRowsForDate(dateKey).filter((row) => {
        if (status !== "all" && normalizeScheduleStatus(row.status) !== status) {
          return false;
        }
        return searchMatchesRow(row, term);
      });
    }

    function getCalendarDayTone(rows) {
      if (!rows.length) return "";
      const statuses = rows.map((row) => normalizeScheduleStatus(row.status));
      if (statuses.includes("failed")) return "has-event-warn";
      if (statuses.includes("pending") || statuses.includes("processing")) return "has-event";
      return "has-event-sent";
    }

    function buildRowsByDateMap(rows = []) {
      const map = new Map();
      rows.forEach((row) => {
        const key = getLocalDateParts(row.send_at).key;
        if (!map.has(key)) {
          map.set(key, []);
        }
        map.get(key).push(row);
      });
      return map;
    }

    function buildAgendaSnapshot(rows = []) {
      return JSON.stringify(
        rows.map((row) => ({
          id: Number(row?.id || 0),
          sendAt: Number(row?.send_at || 0),
          status: normalizeScheduleStatus(row?.status),
          message: row?.message || "",
          filename: row?.filename || "",
          numbers: row?.numbers || "",
          recurrence: row?.recurrence || "none",
          recurrenceEndAt: Number(row?.recurrence_end_at || 0),
          lastLogSentAt: Number(row?.last_log_sent_at || 0),
          lastLogSuccessCount: Number(row?.last_log_success_count || 0),
          lastLogFailureCount: Number(row?.last_log_failure_count || 0),
          lastError: row?.last_error || "",
          updatedAt: Number(row?.updated_at || 0),
        }))
      );
    }

    function buildAgendaRenderStateKey(year, month, dateKey) {
      return `${Number(year || 0)}:${Number(month || 0)}:${String(dateKey || "")}`;
    }

    function syncAgendaRenderState() {
      lastAgendaRenderStateKey = buildAgendaRenderStateKey(calendarViewYear, calendarViewMonth, selectedDateKey);
    }

    function ensureSelectedDateForView(preferredDate = "") {
      const prefix = `${calendarViewYear}-${pad2(calendarViewMonth + 1)}-`;
      const todayKey = getTodayDateKey();

      if (preferredDate && preferredDate.startsWith(prefix)) {
        selectedDateKey = preferredDate;
        return;
      }

      if (selectedDateKey && selectedDateKey.startsWith(prefix)) {
        return;
      }

      if (todayKey.startsWith(prefix)) {
        selectedDateKey = todayKey;
        return;
      }

      const firstEvent = agRows[0];
      if (firstEvent) {
        selectedDateKey = getLocalDateParts(firstEvent.send_at).key;
        return;
      }

      selectedDateKey = buildDateKey(calendarViewYear, calendarViewMonth, 1);
    }

    function renderCalendar(year, month) {
      calendarViewYear = year;
      calendarViewMonth = month;

      const grid = document.getElementById("calendarGrid");
      const label = document.getElementById("calendarMonthLabel");
      if (!grid || !label) return;

      label.textContent = formatMonthLabel(year, month);

      const rowsByDate = buildRowsByDateMap(agRows);
      const weekHeaders = ["D", "S", "T", "Q", "Q", "S", "S"];
      const firstDay = new Date(Date.UTC(year, month, 1));
      const firstWeekday = firstDay.getUTCDay();
      const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
      const daysInPrevMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
      const cells = [];

      for (let offset = firstWeekday - 1; offset >= 0; offset--) {
        const day = daysInPrevMonth - offset;
        const date = new Date(Date.UTC(year, month - 1, day));
        cells.push({
          year: date.getUTCFullYear(),
          month: date.getUTCMonth(),
          day,
          muted: true,
        });
      }

      for (let day = 1; day <= daysInMonth; day++) {
        cells.push({ year, month, day, muted: false });
      }

      while (cells.length % 7 !== 0) {
        const nextIndex = cells.length - daysInMonth - firstWeekday + 1;
        const date = new Date(Date.UTC(year, month + 1, nextIndex));
        cells.push({
          year: date.getUTCFullYear(),
          month: date.getUTCMonth(),
          day: date.getUTCDate(),
          muted: true,
        });
      }

      const todayKey = getTodayDateKey();

      grid.innerHTML = `
        ${weekHeaders.map((item) => `<div class="cal-hd">${item}</div>`).join("")}
        ${cells
          .map((cell) => {
            const dateKey = buildDateKey(cell.year, cell.month, cell.day);
            const rows = rowsByDate.get(dateKey) || [];
            const toneClass = getCalendarDayTone(rows);
            const classes = ["cal-day"];
            if (cell.muted) classes.push("muted");
            if (dateKey === todayKey) classes.push("today");
            if (dateKey === selectedDateKey) classes.push("selected");
            if (toneClass) classes.push(toneClass);

            return `
              <button
                type="button"
                class="${classes.join(" ")}"
                data-date="${dateKey}"
                data-muted="${cell.muted ? "1" : "0"}"
              >
                <span class="cal-day-number">${cell.day}</span>
                ${rows.length ? `<span class="cal-count">${rows.length}</span>` : ""}
              </button>
            `;
          })
          .join("")}
      `;
    }

    function renderSelectedDay() {
      const list = document.getElementById("agendDayList");
      const header = document.getElementById("agendDayHeader");
      const copy = document.getElementById("agendDayCopy");
      const countEl = document.getElementById("agSummaryCount");
      const hintEl = document.getElementById("agSummaryHint");

      renderStatusCounts(getCountsFromRows(agRows));
      syncStatusChipUI();

      if (!list || !header || !copy || !countEl || !hintEl) return;

      if (!selectedDateKey) {
        header.textContent = "Selecione um dia";
        copy.textContent =
          "O calendário destaca a carga de mensagens por data para você agir sem rolar uma lista inteira.";
        countEl.textContent = "Selecione um dia no calendário";
        hintEl.textContent = "Clique em um dia para abrir somente os agendamentos daquela data.";
        list.innerHTML = `
          <div class="empty-schedule-state">
            <strong>Selecione um dia</strong>
            <span>Os itens daquele dia aparecem aqui com ações rápidas de editar, cancelar ou reenviar.</span>
          </div>
        `;
        return;
      }

      const allDayRows = getRowsForDate(selectedDateKey);
      const filteredRows = getFilteredDayRows(selectedDateKey);
      const status = document.getElementById("statusFilter")?.value || "all";
      const term = (document.getElementById("searchTerm")?.value || "").trim();
      const counts = getCountsFromRows(allDayRows);
      const statusMessages = [];

      if (counts.pending) statusMessages.push(`${counts.pending} pendente(s)`);
      if (counts.processing) statusMessages.push(`${counts.processing} em envio`);
      if (counts.failed) statusMessages.push(`${counts.failed} falha(s)`);
      if (!statusMessages.length && counts.sent) statusMessages.push(`${counts.sent} enviado(s)`);

      header.textContent = `${formatDayHeaderLabel(selectedDateKey)} — ${allDayRows.length} agendamento(s)`;
      copy.textContent = statusMessages.length
        ? `Distribuição do dia: ${statusMessages.join(" • ")}.`
        : "Nenhum agendamento carregado para este dia ainda.";

      countEl.textContent =
        filteredRows.length === allDayRows.length
          ? `${allDayRows.length} agendamento(s) neste dia`
          : `${filteredRows.length} de ${allDayRows.length} agendamento(s) visíveis`;

      if (term) {
        hintEl.textContent = `Filtro aplicado para "${term}".`;
      } else if (status !== "all") {
        const labels = {
          pending: "Mostrando só pendentes do dia selecionado.",
          processing: "Mostrando apenas itens em envio.",
          sent: "Mostrando somente enviados deste dia.",
          failed: "Mostrando somente falhas deste dia.",
        };
        hintEl.textContent = labels[status] || "Filtrando a agenda do dia.";
      } else {
        hintEl.textContent = "Clique em outro dia para alternar a agenda e encontrar datas sobrecarregadas.";
      }

      if (!filteredRows.length) {
        list.innerHTML = `
          <div class="empty-schedule-state">
            <strong>${term || status !== "all" ? "Nenhum item com esse filtro" : "Dia sem agendamentos"}</strong>
            <span>${term || status !== "all"
              ? "Limpe a busca ou troque o status para voltar a ver a agenda completa deste dia."
              : "Use o botão de novo agendamento para reservar horários nesta data."}</span>
          </div>
        `;
        return;
      }

      list.innerHTML = filteredRows.map(renderScheduleCard).join("");
      iniciarCountdowns();
    }

    function showDayAgendamentos(date) {
      selectedDateKey = date;
      renderCalendar(calendarViewYear, calendarViewMonth);
      renderSelectedDay();
      syncAgendaRenderState();
    }

    async function fetchMonthSchedules(year, month) {
      const { fromTs, toTs } = getMonthRangeUtc(year, month);
      const rows = [];
      let page = 1;
      let totalPages = 1;

      do {
        const qs = new URLSearchParams({
          status: "all",
          term: "",
          page: String(page),
          pageSize: "100",
          orderBy: "send_at",
          orderDir: "asc",
          from: String(fromTs),
          to: String(toTs),
        });

        const res = await fetch(`/api/agendamentos/list?${qs.toString()}`);
        if (!res.ok) {
          throw new Error("Falha ao carregar agendamentos do mês.");
        }

        const payload = await res.json();
        const batch = Array.isArray(payload?.rows) ? payload.rows : [];
        rows.push(...batch);
        totalPages = Math.max(1, Number(payload?.totalPages) || 1);
        page += 1;
      } while (page <= totalPages);

      return rows;
    }

    // ── Listar ─────────────────────────────────────────────────────
    async function carregarAgendamentos(options = {}) {
      const grid = document.getElementById("calendarGrid");
      const list = document.getElementById("agendDayList");
      const silentRefresh = options.silent === true;

      if (!silentRefresh && grid) {
        grid.innerHTML = `<div class="loading-card">Carregando calendário...</div>`;
      }
      if (!silentRefresh && list) {
        list.innerHTML = `<div class="loading-card">Carregando agendamentos...</div>`;
      }

      try {
        if (!calendarViewYear && !calendarViewMonth) {
          const nowParts = getLocalDateParts(Date.now());
          calendarViewYear = nowParts.year;
          calendarViewMonth = nowParts.month;
        }

        const nextRows = await fetchMonthSchedules(calendarViewYear, calendarViewMonth);
        nextRows.sort((a, b) => Number(a.send_at || 0) - Number(b.send_at || 0));
        agRows = nextRows;
        ensureSelectedDateForView(options.selectedDate || "");

        const nextSnapshot = buildAgendaSnapshot(agRows);
        const nextRenderStateKey = buildAgendaRenderStateKey(calendarViewYear, calendarViewMonth, selectedDateKey);
        const shouldRender =
          !silentRefresh ||
          nextSnapshot !== lastAgendaSnapshot ||
          nextRenderStateKey !== lastAgendaRenderStateKey;

        // Background refresh keeps the current UI mounted to avoid a visible blink every 10 seconds.
        if (shouldRender) {
          renderCalendar(calendarViewYear, calendarViewMonth);
          renderSelectedDay();
          syncAgendaRenderState();
        }

        lastAgendaSnapshot = nextSnapshot;
      } catch (err) {
        if (silentRefresh) {
          return;
        }
        if (grid) {
          grid.innerHTML = `<div class="empty-schedule-state"><strong>Erro ao carregar</strong><span>Tente novamente em alguns instantes.</span></div>`;
        }
        if (list) {
          list.innerHTML = `<div class="empty-schedule-state"><strong>Erro ao carregar</strong><span>Tente novamente em alguns instantes.</span></div>`;
        }
      }
    }

    function resetPageAndLoad() {
      syncStatusChipUI();
      renderSelectedDay();
    }

    function changePage() {
      renderSelectedDay();
    }

    function updatePaginationUI() {}

    function formatarData(ts) {
      const offset = getTimezoneOffsetSelected();
      const d = new Date(ts + offset * 60000);
      const pad = (n) => String(n).padStart(2, "0");
      return `${pad(d.getUTCDate())}/${pad(d.getUTCMonth()+1)}/${d.getUTCFullYear()} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
    }

    function formatarCountdown(ts) {
      const diff = ts - Date.now();
      if (diff <= 0) return "agora";
      const sec = Math.floor(diff / 1000);
      const mins = Math.floor(sec / 60);
      const hrs = Math.floor(mins / 60);
      const days = Math.floor(hrs / 24);
      const rHrs = hrs % 24;
      const rMins = mins % 60;

      if (days > 0) return `em ${days}d ${rHrs}h`;
      if (hrs > 0) return `em ${hrs}h ${rMins}m`;
      const rSecs = sec % 60;
      if (mins > 0) return `em ${mins}m ${rSecs}s`;
      return `em ${rSecs}s`;
    }

    let countdownTimer = null;

    function iniciarCountdowns() {
      if (countdownTimer) clearInterval(countdownTimer);
      const update = () => {
        document.querySelectorAll(".countdown").forEach(el => {
          const status = el.dataset.status;
          if (status !== "pending") {
            el.textContent = "-";
            return;
          }
          const ts = Number(el.dataset.send || 0);
          el.textContent = formatarCountdown(ts);
        });
      };
      update();
      countdownTimer = setInterval(update, 1000);
    }

    function formatarRecorrencia(rec) {
      switch (rec) {
        case "daily": return "Diário";
        case "weekly": return "Semanal";
        case "monthly": return "Mensal";
        default: return "Único";
      }
    }

    function recurrenceBadge(rec) {
      if (!rec || rec === "none") return "";
      return `<div class="recurrence-pill">
        <i class="fa-solid fa-rotate"></i> ${formatarRecorrencia(rec)}
      </div>`;
    }

    async function verDetalhes(id) {
      const modal = document.getElementById("detailsModal");
      const body = document.getElementById("detailsBody");
      if (!modal || !body) return;

      body.innerHTML = "Carregando...";
      modal.classList.remove("hidden");

      try {
        const res = await fetch(`/api/agendamentos/log/${id}`);
        if (!res.ok) throw new Error("Falha ao buscar detalhes");
        const payload = await res.json();
        const log = payload?.log;
        const items = Array.isArray(payload?.items) ? payload.items : [];

        if (!log) {
          body.innerHTML = "<p>Nenhum log encontrado.</p>";
          return;
        }

        const sentAt = new Date(Number(log.sent_at || 0)).toLocaleString("pt-BR");
        const success = log.success_count ?? 0;
        const failure = log.failure_count ?? 0;
        const rows = items.map((it) => {
          const status = it.status === "sent" ? "✅" : "⚠️";
          const when = new Date(Number(it.sent_at || 0)).toLocaleString("pt-BR");
          const err = it.error ? `<div class=\"item-error\">${it.error}</div>` : "";
          return `<div class=\"item-row\"><div>${status} ${formatPhoneDisplay(it.number)}</div><div class=\"item-date\">${when}</div>${err}</div>`;
        }).join("") || "<p>Sem itens detalhados.</p>";

        body.innerHTML = `
          <div class="details-head">
            <div><strong>Processado em:</strong> ${sentAt}</div>
            <div><strong>Sucesso:</strong> ${success}</div>
            <div><strong>Falhas:</strong> ${failure}</div>
          </div>
          <div class="details-items">${rows}</div>
        `;
      } catch (err) {
        body.innerHTML = `<p>Erro ao carregar detalhes.</p>`;
      }
    }

    function fecharDetalhes() {
      const modal = document.getElementById("detailsModal");
      if (modal) modal.classList.add("hidden");
    }

    updateNumCount();
    updatePreview();
    const numsEl = document.getElementById("nums");
    numsEl?.addEventListener("focus", ensureNumsPrefixOnFocus);
    numsEl?.addEventListener("keydown", handleNumsKeydown);
    const tzSel = document.getElementById("timezoneSelect");
    if (tzSel) tzSel.value = String(USER_TZ);
    toggleRecurrenceEnd();
    syncStatusChipUI();

    const todayParts = getLocalDateParts(Date.now());
    calendarViewYear = todayParts.year;
    calendarViewMonth = todayParts.month;
    selectedDateKey = todayParts.key;

    document.getElementById("btnNovoAgend")?.addEventListener("click", () => {
      prepareNewSchedule(selectedDateKey);
    });
    document.getElementById("btnCloseAgendModal")?.addEventListener("click", closeScheduleFormModal);
    document.getElementById("scheduleFormModal")?.addEventListener("click", (event) => {
      if (event.target?.id === "scheduleFormModal") {
        closeScheduleFormModal();
      }
    });

    const goToTodayInCalendar = () => {
      const todayKey = getTodayDateKey();
      const parts = parseDateKey(todayKey);
      if (!parts) return;
      calendarViewYear = parts.year;
      calendarViewMonth = parts.month;
      selectedDateKey = todayKey;
      carregarAgendamentos({ selectedDate: todayKey });
    };

    document.getElementById("btnCalendarToday")?.addEventListener("click", goToTodayInCalendar);
    document.getElementById("btnDayToday")?.addEventListener("click", goToTodayInCalendar);

    document.getElementById("btnCalendarPrev")?.addEventListener("click", () => {
      const next = new Date(Date.UTC(calendarViewYear, calendarViewMonth - 1, 1));
      calendarViewYear = next.getUTCFullYear();
      calendarViewMonth = next.getUTCMonth();
      carregarAgendamentos();
    });

    document.getElementById("btnCalendarNext")?.addEventListener("click", () => {
      const next = new Date(Date.UTC(calendarViewYear, calendarViewMonth + 1, 1));
      calendarViewYear = next.getUTCFullYear();
      calendarViewMonth = next.getUTCMonth();
      carregarAgendamentos();
    });

    document.getElementById("calendarGrid")?.addEventListener("click", (event) => {
      const trigger = event.target.closest("[data-date]");
      if (!trigger) return;

      const dateKey = String(trigger.getAttribute("data-date") || "");
      const parts = parseDateKey(dateKey);
      if (!parts) return;

      if (trigger.getAttribute("data-muted") === "1") {
        calendarViewYear = parts.year;
        calendarViewMonth = parts.month;
        selectedDateKey = dateKey;
        carregarAgendamentos({ selectedDate: dateKey });
        return;
      }

      showDayAgendamentos(dateKey);
    });

    carregarAgendamentos({ selectedDate: selectedDateKey });
    setInterval(() => carregarAgendamentos({ selectedDate: selectedDateKey, silent: true }), 10000);
  </script>

</body>

</html>
