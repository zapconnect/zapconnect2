<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <title>Fluxos Inteligentes</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/fluxos.css">
  <link rel="icon" href="/img/favinco.png" />
</head>
<body>
  <main class="flows-page">
    <header class="page-header">
      <div>
        <p class="page-kicker">Automação</p>
        <h1>Fluxos Inteligentes</h1>
        <p class="page-copy">
          Organize a ordem das ações com nós visuais, edite cada etapa inline e simule o comportamento antes de salvar.
        </p>
      </div>
      <div class="page-actions">
        <button id="btnNewFlow" class="btn btn-primary">+ Novo fluxo</button>
      </div>
    </header>

    <section class="flow-card flow-card--welcome" id="welcomeCard">
      <div class="flow-card-header">
        <div>
          <span class="flow-chip">Primeiro contato</span>
          <h2>Fluxo de Boas-vindas automático</h2>
          <p class="flow-description">
            Dispara na primeira mensagem de um novo contato registrado no CRM, sem depender de palavra-chave.
          </p>
          <div id="welcomeStatus" class="flow-status">Carregando...</div>
        </div>
        <div class="flow-toolbar">
          <button id="btnWelcomeEdit" class="btn btn-secondary">Editar fluxo</button>
          <button id="btnWelcomeToggle" class="btn btn-secondary">Ativar/Desativar</button>
          <button id="btnWelcomeTest" class="btn btn-ghost">Simular</button>
        </div>
      </div>

      <div class="flow-preview">
        <div class="flow-preview-head">
          <strong>Prévia das ações</strong>
          <span class="flow-preview-hint">As quatro primeiras etapas aparecem aqui.</span>
        </div>
        <div id="welcomeActions" class="preview-list"></div>
      </div>
    </section>

    <section class="flows-section">
      <div class="section-head">
        <div>
          <h2>Fluxos por gatilho</h2>
          <p>Crie automações por palavra-chave e mantenha a ordem das etapas arrastando os nós.</p>
        </div>
      </div>
      <div id="flowsWrap" class="flow-grid"></div>
    </section>
  </main>

  <div id="welcomeModal" class="modal-overlay" style="display:none;">
    <div class="modal-shell">
      <div class="modal-header">
        <div>
          <span class="flow-chip">Boas-vindas</span>
          <h2>Editar fluxo de primeiro contato</h2>
        </div>
      </div>

      <div class="modal-form">
        <label class="field-block">
          <span>Nome</span>
          <input id="welcomeName" type="text" placeholder="Ex.: Boas-vindas padrão">
        </label>

        <label class="toggle-block">
          <input type="checkbox" id="welcomeActive">
          <span>Fluxo ativo</span>
        </label>
      </div>

      <section class="builder-card">
        <div class="builder-head">
          <div>
            <h3>Etapas do fluxo</h3>
            <p>Arraste para reordenar e clique em editar para ajustar o conteúdo de cada nó.</p>
          </div>
          <div class="builder-actions">
            <select id="welcomeAddActionType">
              <option value="send_text">Enviar texto</option>
              <option value="delay">Aguardar (segundos)</option>
              <option value="send_media">Enviar mídia</option>
              <option value="handover_human">Encaminhar para humano</option>
              <option value="update_crm">Atualizar CRM</option>
              <option value="call_webhook">Chamar webhook</option>
              <option value="condition">Condição</option>
            </select>
            <button id="welcomeAddAction" class="btn btn-primary" type="button">Adicionar nó</button>
          </div>
        </div>
        <div id="welcomeModalActions" class="flow-node-list"></div>
      </section>

      <div class="modal-footer">
        <button id="welcomeCancel" class="btn btn-ghost" type="button">Cancelar</button>
        <button id="welcomeSave" class="btn btn-primary" type="button">Salvar</button>
      </div>
    </div>
  </div>

  <div id="flowModal" class="modal-overlay" style="display:none;">
    <div class="modal-shell">
      <div class="modal-header">
        <div>
          <span class="flow-chip">Fluxo por gatilho</span>
          <h2 id="flowModalTitle">Novo Fluxo</h2>
        </div>
      </div>

      <div class="modal-form modal-form--split">
        <label class="field-block">
          <span>Nome</span>
          <input id="flowName" type="text" placeholder="Ex.: Fluxo de orçamento">
        </label>

        <label class="field-block">
          <span>Trigger (palavra/expressão)</span>
          <input id="flowTrigger" type="text" placeholder="Ex.: preço, orçamento, ajuda">
        </label>

        <label class="toggle-block">
          <input type="checkbox" id="flowActive" checked>
          <span>Fluxo ativo</span>
        </label>
      </div>

      <section class="builder-card">
        <div class="builder-head">
          <div>
            <h3>Etapas do fluxo</h3>
            <p>Os nós seguem a ordem exibida na tela. Arraste para reorganizar antes de salvar.</p>
          </div>
          <div class="builder-actions">
            <select id="addActionType">
              <option value="send_text">Enviar texto</option>
              <option value="delay">Aguardar (segundos)</option>
              <option value="send_media">Enviar mídia</option>
              <option value="handover_human">Encaminhar para humano</option>
              <option value="update_crm">Atualizar CRM</option>
              <option value="call_webhook">Chamar webhook</option>
              <option value="condition">Condição</option>
            </select>
            <button id="btnAddAction" class="btn btn-primary" type="button">Adicionar nó</button>
          </div>
        </div>
        <div id="flowActions" class="flow-node-list"></div>
      </section>

      <div class="modal-footer">
        <button id="flowCancel" class="btn btn-ghost" type="button">Cancelar</button>
        <button id="flowSave" class="btn btn-primary" type="button">Salvar fluxo</button>
      </div>
    </div>
  </div>

  <div id="userdata" data-user='<%- JSON.stringify(user || {}) %>'></div>

  <script src="/js/loading-utils.js"></script>
  <script src="/js/flow-node-editor.js"></script>
  <script src="/js/welcome-flow.js"></script>
  <script src="/js/fluxos.js"></script>
</body>
</html>
