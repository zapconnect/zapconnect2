<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="utf-8" />
  <title>CRM Kanban • ZapConnect</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <%- include("partials/app-head-core") %>
  <!-- CSS -->
  <link rel="stylesheet" href="/css/crm.css">
  <link rel="stylesheet" href="/css/crm-insights.css">
  <link rel="stylesheet" href="/css/app-shell.css">
  <script src="/js/app-shell.js" defer></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    window.USER_ID = "<%= user.id %>";
  </script>
</head>

<body class="has-app-sidebar" data-default-ddi="<%= user.default_ddi || '55' %>">
  <%- include("partials/app-sidebar", { activePage: "crm" }) %>

  <div class="page">

    <main class="main">

      <!-- =============================
         🔝 HEADER
    ============================== -->
      <header class="main-header">

        <div class="title">
          <h1>
            <i class="fa-solid fa-chart-column"></i>
            Pipeline de Vendas
          </h1>
          <p>Arraste os clientes entre os estágios</p>
        </div>

        <div class="main-actions">
          <div class="sort-controls">
            <select id="sortSelect" class="sort-select" title="Ordenar por">
              <option value="name">Nome</option>
              <option value="last_seen">Última atividade</option>
              <option value="follow_up">Follow-up</option>
              <option value="value">Valor</option>
            </select>
            <button id="sortDirBtn" class="btn ghost sort-dir">↑ Asc</button>
          </div>

          <button id="refreshBtn" class="btn ghost" title="Atualizar">
            <i class="fa-solid fa-rotate"></i>
          </button>

          <button id="exportBtn" class="btn ghost compact-label" title="Exportar clientes filtrados como CSV">
            <i class="fa-solid fa-file-csv"></i>
            <span class="btn-label">Exportar CSV</span>
          </button>

          <button id="addClientBtn" class="btn compact-label">
            <i class="fa-solid fa-user-plus"></i>
            <span class="btn-label">Novo Cliente</span>
          </button>

          <button id="crmLoadMore" class="btn ghost" style="display:none">
            <i class="fa-solid fa-angles-down"></i>
            Carregar mais
          </button>

          <a href="/drips" class="btn ghost compact-label" title="Abrir automacoes de funil">
            <i class="fa-solid fa-timeline"></i>
            <span class="btn-label">Drip Campaigns</span>
          </a>


        </div>
      </header>

      <section class="crm-insights" aria-labelledby="crmInsightsTitle" aria-busy="true">
        <div class="crm-insights-header">
          <div>
            <span class="crm-insights-eyebrow">Visão comercial</span>
            <h2 id="crmInsightsTitle">Resumo do pipeline</h2>
            <p>Indicadores calculados a partir dos contatos e negócios do seu CRM.</p>
          </div>
          <div class="crm-insights-actions">
            <button type="button" class="btn ghost crm-insights-refresh" id="crmSummaryRefresh">
              <i class="fa-solid fa-rotate"></i>
              Atualizar indicadores
            </button>
            <button
              type="button"
              class="btn ghost crm-section-toggle"
              id="crmInsightsToggle"
              aria-expanded="true"
              aria-controls="crmInsightsContent"
              aria-label="Minimizar visão comercial"
              title="Minimizar visão comercial"
            >
              <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="crm-insights-content" id="crmInsightsContent">
          <div class="crm-insights-grid">
            <article class="crm-insight-card">
              <span>Contatos</span>
              <strong id="crmSummaryContacts">—</strong>
              <small>Em toda a sua base</small>
            </article>
            <article class="crm-insight-card">
              <span>Oportunidades abertas</span>
              <strong id="crmSummaryOpenDeals">—</strong>
              <small>Etapas diferentes de Fechado e Perdido</small>
            </article>
            <article class="crm-insight-card crm-insight-card-value">
              <span>Valor do pipeline</span>
              <strong id="crmSummaryPipelineValue">—</strong>
              <small>Negócios ainda em andamento</small>
            </article>
            <article class="crm-insight-card">
              <span>Negócios fechados</span>
              <strong id="crmSummaryWonCount">—</strong>
              <small id="crmSummaryWonValue">Valor fechado: —</small>
            </article>
            <article class="crm-insight-card crm-insight-card-alert">
              <span>Follow-ups vencidos</span>
              <strong id="crmSummaryOverdue">—</strong>
              <small>Oportunidades abertas com data anterior a agora</small>
            </article>
            <article class="crm-insight-card">
              <span>Próximos follow-ups</span>
              <strong id="crmSummaryUpcoming">—</strong>
              <small>Agendados para os próximos 7 dias</small>
            </article>
          </div>

          <div class="crm-insights-stages">
            <div class="crm-insights-stages-head">
              <h3>Distribuição por etapa</h3>
              <span id="crmSummaryUpdated"></span>
            </div>
            <div id="crmStageSummary" class="crm-stage-summary-list">
              <p class="crm-insights-empty">Carregando etapas…</p>
            </div>
          </div>
          <p class="crm-insights-status" id="crmSummaryStatus" role="status" aria-live="polite">Carregando indicadores…</p>
        </div>
      </section>

      <!-- =============================
         🔎 FILTROS
    ============================== -->
      <div class="crm-filters-bar">
        <div class="crm-filters-header">
          <strong>Filtros</strong>
          <span id="crmResultCount" class="crm-result-count">0 clientes</span>
          <button
            type="button"
            class="btn ghost crm-section-toggle"
            id="crmFiltersToggle"
            aria-expanded="true"
            aria-controls="crmFiltersContent"
            aria-label="Minimizar filtros"
            title="Minimizar filtros"
          >
            <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
          </button>
        </div>

        <div class="crm-filters-content" id="crmFiltersContent">
          <div class="crm-search-row">
            <label class="crm-search-field" for="crmSearch">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input
                id="crmSearch"
                class="crm-search-input"
                placeholder="Buscar cliente ou número..."
                oninput="updateFilter('text', this.value)"
              >
            </label>
          </div>

          <div class="crm-filter-group">
            <span class="crm-filter-label">Stages</span>
            <div class="filter-pills" id="stagePills"></div>
          </div>

          <div class="crm-filter-group">
            <span class="crm-filter-label">Tags</span>
            <div class="filter-pills" id="tagPills"></div>
          </div>

          <div class="crm-filter-extras">
            <label class="crm-extra-field" for="minValueInput">
              <span>Valor mínimo</span>
              <input
                type="number"
                id="minValueInput"
                min="0"
                step="0.01"
                placeholder="0"
                onchange="updateFilter('minValue', this.value)"
              >
            </label>

            <label class="crm-checkbox-field" for="followUpCheck">
              <input
                type="checkbox"
                id="followUpCheck"
                onchange="updateFilter('hasFollowUp', this.checked)"
              >
              <span>Com follow-up</span>
            </label>

            <button type="button" class="btn ghost btn-clear-filters" onclick="clearAllFilters()">
              <i class="fa-solid fa-rotate-left"></i>
              Limpar tudo
            </button>
          </div>
        </div>
      </div>

      <!-- =============================
         📌 KANBAN
    ============================== -->
      <section class="kanban-board" id="kanbanBoard">

        <!-- NOVO -->
        <div class="kanban-column" data-stage="Novo">
          <div class="kanban-column-header">
            <span class="dot dot-novo"></span>
            <span class="kanban-column-title">Novo</span>
            <span class="count" id="count-Novo">0</span>
            <span class="col-value" id="value-Novo"></span>
            <button class="kanban-column-toggle" type="button" data-column-toggle aria-expanded="true" aria-label="Minimizar coluna Novo" title="Minimizar coluna">
              <i class="fa-solid fa-angles-left" aria-hidden="true"></i>
            </button>
          </div>
          <div class="kanban-dropzone" data-stage="Novo"></div>
        </div>

        <!-- QUALIFICANDO -->
        <div class="kanban-column" data-stage="Qualificando">
          <div class="kanban-column-header">
            <span class="dot dot-qualificando"></span>
            <span class="kanban-column-title">Qualificando</span>
            <span class="count" id="count-Qualificando">0</span>
            <span class="col-value" id="value-Qualificando"></span>
            <button class="kanban-column-toggle" type="button" data-column-toggle aria-expanded="true" aria-label="Minimizar coluna Qualificando" title="Minimizar coluna">
              <i class="fa-solid fa-angles-left" aria-hidden="true"></i>
            </button>
          </div>
          <div class="kanban-dropzone" data-stage="Qualificando"></div>
        </div>

        <!-- NEGOCIAÇÃO -->
        <div class="kanban-column" data-stage="Negociação">
          <div class="kanban-column-header">
            <span class="dot dot-negociacao"></span>
            <span class="kanban-column-title">Negociação</span>
            <span class="count" id="count-Negociação">0</span>
            <span class="col-value" id="value-Negociação"></span>
            <button class="kanban-column-toggle" type="button" data-column-toggle aria-expanded="true" aria-label="Minimizar coluna Negociação" title="Minimizar coluna">
              <i class="fa-solid fa-angles-left" aria-hidden="true"></i>
            </button>
          </div>
          <div class="kanban-dropzone" data-stage="Negociação"></div>
        </div>

        <!-- FECHADO -->
        <div class="kanban-column" data-stage="Fechado">
          <div class="kanban-column-header">
            <span class="dot dot-fechado"></span>
            <span class="kanban-column-title">Fechado</span>
            <span class="count" id="count-Fechado">0</span>
            <span class="col-value" id="value-Fechado"></span>
            <button class="kanban-column-toggle" type="button" data-column-toggle aria-expanded="true" aria-label="Minimizar coluna Fechado" title="Minimizar coluna">
              <i class="fa-solid fa-angles-left" aria-hidden="true"></i>
            </button>
          </div>
          <div class="kanban-dropzone" data-stage="Fechado"></div>
        </div>

        <!-- PERDIDO -->
        <div class="kanban-column" data-stage="Perdido">
          <div class="kanban-column-header">
            <span class="dot dot-perdido"></span>
            <span class="kanban-column-title">Perdido</span>
            <span class="count" id="count-Perdido">0</span>
            <span class="col-value" id="value-Perdido"></span>
            <button class="kanban-column-toggle" type="button" data-column-toggle aria-expanded="true" aria-label="Minimizar coluna Perdido" title="Minimizar coluna">
              <i class="fa-solid fa-angles-left" aria-hidden="true"></i>
            </button>
          </div>
          <div class="kanban-dropzone" data-stage="Perdido"></div>
        </div>

      </section>

      <!-- =============================
         🧾 MODAL CLIENTE
    ============================== -->
      <div id="clientModal" class="modal-overlay">
        <div class="modal">
          <button class="close-modal" id="closeClientModal">
            <i class="fa-solid fa-xmark"></i>
          </button>

          <h2 id="modalTitle">Novo Cliente</h2>

          <label>Nome</label>
          <input id="modalName">

          <label>Telefone</label>
          <input id="modalPhone" placeholder="<%= user.default_ddi || '55' %> 11 99999-9999" inputmode="tel">

          <label>Cidade / Estado</label>
          <input id="modalCity">

          <label>Valor do negócio (R$)</label>
          <input id="modalValue" type="text" inputmode="decimal" placeholder="0,00">

          <label>Follow-up — data de retorno</label>
          <input id="modalFollowUp" type="date">

          <label>Estágio</label>
          <select id="modalStage">
            <option>Novo</option>
            <option>Qualificando</option>
            <option>Negociação</option>
            <option>Fechado</option>
            <option>Perdido</option>
          </select>

          <h3>Tags</h3>
          <div id="modalTags" class="tags"></div>

          <div class="tag-row">
            <input id="modalNewTag" placeholder="Nova tag">
            <button class="btn small" id="modalAddTag">Adicionar</button>
          </div>

          <h3>Notas</h3>
          <div id="modalNotes" class="notes-area"></div>

          <textarea id="modalNoteText" placeholder="Nova nota..."></textarea>
          <button class="btn small" id="modalAddNote">Salvar Nota</button>

          <div class="modal-actions">
            <button id="modalDelete" class="btn btn-danger" style="display:none;">
              <i class="fa-solid fa-trash"></i> Excluir
            </button>
            <div style="flex:1"></div>
            <button id="modalCancel" class="btn ghost">Cancelar</button>
            <button id="modalSave" class="btn">Salvar Cliente</button>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- TOASTS -->
  <div class="toasts" id="toasts"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/loading-utils.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/crm.js"></script>

</body>

</html>
