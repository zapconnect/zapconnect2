<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <title>Painel • ZapConnect</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include("partials/app-head-core") %>

  <!-- Boxicons -->
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/painel.css">
  <link rel="stylesheet" href="/css/initial-ai-setup.css">
  <link rel="stylesheet" href="/css/app-shell.css">
  <script src="/js/app-shell.js" defer></script>
  <script src="/js/initial-ai-setup.js" defer></script>

  <script src="/socket.io/socket.io.js"></script>
</head>

<body
  class="has-app-sidebar app-dashboard-page"
  data-sessions-count="<%= Array.isArray(sessions) ? sessions.length : 0 %>"
  data-has-prompt="<%= user.prompt && user.prompt.length > 10 ? 'true' : 'false' %>"
  data-first-msg-sent="<%= Number(user.onboarding_step || 0) >= 4 ? 'true' : 'false' %>"
  data-user-onboarding-step="<%= Number(user.onboarding_step || 0) %>"
>
  <%- include("partials/app-sidebar", { activePage: "painel" }) %>

  <% if (showInitialAiSetup) { %>
    <% const initialSetupFirstName = String(user?.name || "").trim().split(/\s+/)[0] || ""; %>
    <% const initialSetupConnectedSession = (sessions || []).find((session) => String(session.status || "").toLowerCase() === "connected"); %>
    <div class="initial-ai-setup" id="initialAiSetup" aria-hidden="false">
      <button class="initial-ai-setup-backdrop" type="button" data-initial-setup-later aria-label="Configurar depois"></button>
      <section class="initial-ai-setup-dialog" role="dialog" aria-modal="true" aria-labelledby="initialSetupTitle">
        <header class="initial-ai-setup-header">
          <div class="initial-ai-setup-brand">
            <span class="initial-ai-setup-icon"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i></span>
            <div>
              <span class="initial-ai-setup-kicker">Assistente de configuração</span>
              <h1 id="initialSetupTitle">Vamos preparar seu primeiro agente</h1>
            </div>
          </div>
          <button class="initial-ai-setup-close" type="button" data-initial-setup-later aria-label="Configurar depois">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </header>

        <div class="initial-ai-setup-progress" aria-label="Etapas da configuração">
          <span class="is-active" data-setup-progress="1">1. Seu negócio</span>
          <span data-setup-progress="2">2. Atendimento</span>
          <span data-setup-progress="3">3. Revisão</span>
        </div>

        <div class="initial-ai-setup-chat" id="initialSetupChat" role="log" aria-live="polite">
          <span class="initial-ai-setup-avatar"><i class="fa-solid fa-robot" aria-hidden="true"></i></span>
          <p id="initialSetupAssistantMessage">Oi<%= initialSetupFirstName ? `, ${initialSetupFirstName}` : "" %>! Vou ajudar a montar um agente para o seu negócio. Você revisa tudo antes de salvar.</p>
        </div>

        <div class="initial-ai-setup-body">
          <section class="initial-setup-step" data-setup-panel="1">
            <label for="initialSetupAgentName">Nome do agente</label>
            <input id="initialSetupAgentName" type="text" maxlength="120" value="Atendimento principal" autocomplete="off" required>

            <label for="initialSetupCompany">Nome da empresa</label>
            <input id="initialSetupCompany" type="text" maxlength="120" autocomplete="organization" required placeholder="Ex.: Loja Central">

            <label for="initialSetupBusiness">O que sua empresa oferece e quem costuma atender?</label>
            <textarea id="initialSetupBusiness" rows="4" maxlength="1000" required placeholder="Conte sobre seus produtos ou serviços, seu público e as dúvidas que os clientes costumam trazer."></textarea>
            <p class="initial-setup-hint">Inclua apenas informações que o agente pode usar como verdade.</p>
          </section>

          <section class="initial-setup-step" data-setup-panel="2" hidden>
            <label for="initialSetupGoal">Qual deve ser o principal objetivo?</label>
            <select id="initialSetupGoal">
              <option value="Atender dúvidas e apresentar produtos ou serviços">Atender dúvidas e apresentar soluções</option>
              <option value="Ajudar o cliente a concluir uma compra">Apoiar vendas</option>
              <option value="Coletar informações e qualificar oportunidades">Qualificar oportunidades</option>
              <option value="Orientar clientes que precisam de suporte">Prestar suporte</option>
              <option value="Coletar dados para uma solicitação de agendamento">Receber pedidos de agendamento</option>
            </select>

            <label for="initialSetupTone">Tom de voz</label>
            <select id="initialSetupTone">
              <option value="cordial, claro e profissional">Cordial e profissional</option>
              <option value="leve, próximo e informal, sem perder o respeito">Leve e informal</option>
              <option value="objetivo, direto e educado">Objetivo e direto</option>
              <option value="acolhedor, paciente e didático">Acolhedor e didático</option>
            </select>

            <label for="initialSetupRules">Há alguma regra ou limite importante?</label>
            <textarea id="initialSetupRules" rows="3" maxlength="500" placeholder="Ex.: não conceder descontos; não confirmar disponibilidade sem consultar a equipe."></textarea>

            <label for="initialSetupHandoff">Em que situação deve chamar uma pessoa?</label>
            <textarea id="initialSetupHandoff" rows="2" maxlength="300" placeholder="Ex.: reclamações, dúvidas que não constam nas informações da empresa ou pedido explícito do cliente."></textarea>

            <label for="initialSetupSession">Onde usar este agente?</label>
            <select id="initialSetupSession">
              <option value="" <%= initialSetupConnectedSession ? "" : "selected" %>>Aplicar como configuração padrão da conta</option>
              <% (sessions || []).forEach((session) => { %>
                <option value="<%= session.session_name %>" <%= initialSetupConnectedSession && initialSetupConnectedSession.session_name === session.session_name ? "selected" : "" %>>
                  <%= session.session_name %> — <%= session.status === "connected" ? "conectada" : "não conectada" %>
                </option>
              <% }) %>
            </select>
            <p class="initial-setup-hint">O agente só responde pelo WhatsApp quando houver uma sessão conectada.</p>
          </section>

          <section class="initial-setup-step" data-setup-panel="3" hidden>
            <div id="initialSetupGenerating" class="initial-setup-generating" hidden>
              <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
              <strong>Estou organizando suas respostas em um perfil de atendimento…</strong>
              <span>Isso pode levar alguns segundos.</span>
            </div>
            <div id="initialSetupReview" class="initial-setup-review" hidden>
              <div class="initial-setup-review-heading">
                <strong>Confira a proposta do agente</strong>
                <span>Ela ainda não foi salva nem aplicada.</span>
              </div>
              <div id="initialSetupReviewFields" class="initial-setup-review-fields"></div>
            </div>
          </section>

          <section id="initialSetupSuccess" class="initial-setup-success" hidden>
            <span class="initial-setup-success-icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
            <h2>Seu agente está configurado</h2>
            <p id="initialSetupSuccessMessage">A configuração foi salva na sua conta. Você pode conectá-la a uma sessão do WhatsApp quando estiver pronto.</p>
            <div class="initial-setup-success-actions">
              <a class="btn btn-primary" href="/painel#whatsapp-connection">Conectar WhatsApp</a>
              <a class="btn btn-secondary" href="/ai-assistant">Ajustar configuração</a>
            </div>
          </section>
        </div>

        <footer class="initial-ai-setup-footer">
          <p id="initialSetupStatus" class="initial-setup-status" role="status" aria-live="polite"></p>
          <div class="initial-setup-actions" id="initialSetupActions">
            <button class="initial-setup-later" type="button" data-initial-setup-later>Fazer depois</button>
            <div class="initial-setup-actions-right">
              <button class="btn btn-secondary" id="initialSetupBack" type="button" hidden>Voltar</button>
              <button class="btn btn-primary" id="initialSetupNext" type="button">Continuar</button>
              <button class="btn btn-primary" id="initialSetupGenerate" type="button" hidden>
                <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Montar proposta
              </button>
              <button class="btn btn-primary" id="initialSetupSave" type="button" hidden disabled>
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Salvar e ativar
              </button>
            </div>
          </div>
        </footer>
      </section>
    </div>
  <% } %>

  <!-- ============================
🔝 HEADER
============================= -->
  <header class="topbar">
    <div class="brand">
      <img src="/img/logo3.png" alt="ZapConnect" class="brand-logo">
    </div>

    <div class="top-actions">
      <div id="status-indicator" class="status-indicator">
        <span id="status-dot" class="status-dot status-offline"></span>
        <span id="status-text">Offline</span>
      </div>

      <button class="btn-danger small" onclick="logout()">
        <i class="fa-solid fa-right-from-bracket"></i>
        Sair
      </button>
    </div>
  </header>

  <!-- ============================
📦 CONTEÚDO
============================= -->
  <main class="container">
    <% const onboardingStepValue = Number(user?.onboarding_step || 0); %>
    <% const shouldShowOnboarding = (sessions?.length || 0) === 0 || onboardingStepValue < 4; %>

    <% if (shouldShowOnboarding) { %>
      <section class="onboarding-checklist" id="onboarding-checklist" aria-labelledby="onboarding-title">
        <div class="onboarding-header">
          <div>
            <span class="tag">Primeiros passos</span>
            <h2 class="onboarding-title" id="onboarding-title">Ative o ZapConnect em 4 passos</h2>
            <p>Seu painel já está pronto. Agora conecte um WhatsApp, ajuste a IA e valide com uma primeira conversa real.</p>
          </div>

          <div class="onboarding-header-actions">
            <div class="onboarding-progress-copy">
              <strong id="onboarding-progress-label">1 de 4 concluídos</strong>
              <span id="onboarding-progress-hint">Checklist inicial</span>
            </div>
            <button type="button" class="btn btn-secondary btn-sm onboarding-dismiss" id="onboarding-dismiss">
              Dispensar
            </button>
          </div>
        </div>

        <div class="onboarding-progress-bar" aria-hidden="true">
          <div class="onboarding-bar" id="onboarding-bar"></div>
        </div>

        <div class="onboarding-steps" id="onboarding-steps">
          <article class="onboarding-step-card step-done" data-step-index="1">
            <div class="onboarding-step-top">
              <span class="onboarding-step-badge">Passo 1</span>
              <span class="onboarding-step-state" data-step-status>Concluído</span>
            </div>
            <h3>Criar conta</h3>
            <p>Seu acesso já foi criado. A partir daqui, o objetivo é colocar a operação para rodar.</p>
            <a href="/user" class="onboarding-step-link">Ver conta</a>
          </article>

          <article class="onboarding-step-card step-pending" data-step-index="2">
            <div class="onboarding-step-top">
              <span class="onboarding-step-badge">Passo 2</span>
              <span class="onboarding-step-state" data-step-status>Pendente</span>
            </div>
            <h3>Conectar WhatsApp</h3>
            <p>Crie sua primeira sessão, escaneie o QR Code e deixe o canal pronto para responder clientes.</p>
            <a href="/painel#whatsapp-connection" class="onboarding-step-link">Ir para sessões</a>
          </article>

          <article class="onboarding-step-card step-pending" data-step-index="3">
            <div class="onboarding-step-top">
              <span class="onboarding-step-badge">Passo 3</span>
              <span class="onboarding-step-state" data-step-status>Pendente</span>
            </div>
            <h3>Configurar IA</h3>
            <p>Defina tom, regras e limites para a IA responder do seu jeito antes de atender automaticamente.</p>
            <a href="#prompt" class="onboarding-step-link" onclick="openAiConfigModal()">Configurar IA</a>
          </article>

          <article class="onboarding-step-card step-pending" data-step-index="4">
            <div class="onboarding-step-top">
              <span class="onboarding-step-badge">Passo 4</span>
              <span class="onboarding-step-state" data-step-status>Pendente</span>
            </div>
            <h3>Enviar mensagem de teste</h3>
            <p>Abra um chat e envie a primeira mensagem manual para validar a sessão conectada e encerrar o onboarding.</p>
            <a href="/chat" class="onboarding-step-link">Testar no chat</a>
          </article>
        </div>
      </section>
    <% } %>

    <!-- ============================
    📊 MÉTRICAS
    ============================= -->
    <div class="stats-grid">

      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(46,230,166,.15);color:#2ee6a6">
          <i class="fa-brands fa-whatsapp"></i>
        </div>
        <div class="stat-body">
          <div class="stat-value" id="stat-sessions">—</div>
          <div class="stat-label">Sessões ativas</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(90,200,250,.15);color:#5ac8fa">
          <i class="fa-solid fa-address-book"></i>
        </div>
        <div class="stat-body">
          <div class="stat-value" id="stat-clientes">—</div>
          <div class="stat-label">Clientes no CRM</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(242,201,76,.15);color:#f2c94c">
          <i class="fa-solid fa-clock"></i>
        </div>
        <div class="stat-body">
          <div class="stat-value" id="stat-agendamentos">—</div>
          <div class="stat-label">Agendamentos pendentes</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(108,100,239,.15);color:#a89ef5">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div class="stat-body">
          <div class="stat-value" id="stat-ia">—</div>
          <div class="stat-label">Mensagens IA no mês</div>
          <div class="stat-meta" id="stat-ia-meta">Carregando limite...</div>
        </div>
      </div>

    </div>

    <section class="card plan-usage-card" id="plan-usage-card" style="display:none;">
      <div class="plan-usage-head">
        <div class="plan-usage-copy">
          <span class="plan-usage-kicker">Uso do plano</span>
          <h2><i class="fa-solid fa-gauge-high"></i> Limites do mes</h2>
          <p id="plan-usage-summary">
            Acompanhe o consumo da IA e das sessoes antes de atingir o limite.
          </p>
        </div>

        <div class="plan-usage-actions">
          <span class="plan-usage-pill" id="plan-usage-pill">Plano -</span>
          <a href="/checkout" class="btn btn-accent btn-sm" id="plan-usage-link">Ver planos</a>
        </div>
      </div>

      <div class="plan-usage-grid">
        <div class="ia-usage-wrap" id="ia-usage-wrap">
          <div class="ia-usage-header">
            <span class="ia-usage-label">Mensagens IA</span>
            <span class="ia-usage-count" id="ia-usage-count">—</span>
          </div>
          <div class="ia-progress-track">
            <div class="ia-progress-bar" id="ia-progress-bar"></div>
          </div>
          <div class="ia-usage-footer">
            <span id="ia-usage-remaining"></span>
            <span id="ia-usage-renewal"></span>
          </div>
        </div>

        <div class="ia-usage-wrap" id="session-usage-wrap">
          <div class="ia-usage-header">
            <span class="ia-usage-label">Sessoes WhatsApp</span>
            <span class="ia-usage-count" id="session-usage-count">—</span>
          </div>
          <div class="ia-progress-track">
            <div class="ia-progress-bar" id="session-progress-bar"></div>
          </div>
          <div class="ia-usage-footer">
            <span id="session-usage-remaining"></span>
            <span id="session-usage-status"></span>
          </div>
        </div>
      </div>
    </section>

    <div class="grid">

      <!-- 🤖 Configuração guiada da IA -->
      <section class="card ai-config-card" id="prompt">
        <div class="ai-config-card-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
        <div class="ai-config-card-copy">
          <span class="tag">Atendimento inteligente</span>
          <h2>Configure sua IA</h2>
          <p>Organize como a IA atende em oito áreas simples. Nós cuidamos das instruções técnicas por trás.</p>
          <div id="ai-config-summary" class="ai-config-summary" aria-live="polite">
            Ainda não configurada. Comece pela identidade e pelo objetivo da IA.
          </div>
        </div>
        <button class="btn btn-primary ai-config-card-action" type="button" onclick="openAiConfigModal()">
          <i class="fa-solid fa-sliders"></i>
          Configurar IA
        </button>
      </section>

      <section class="card nav-overview-card">
        <div class="nav-overview-head">
          <span class="tag">Navegação fixa</span>
          <h2><i class="fa-solid fa-compass"></i> Central de navegação</h2>
          <p>Os módulos agora ficam presos na barra lateral. Use Principal, Envios e Configurações para trocar de contexto sem voltar ao painel.</p>
        </div>

        <div class="nav-overview-grid">
          <article class="nav-overview-group">
            <span>Principal</span>
            <strong>Chats, CRM, Analytics e a visão geral do sistema.</strong>
          </article>

          <article class="nav-overview-group">
            <span>Envios</span>
            <strong>Disparo, Agendamentos, Drip e Cobranças em uma mesma trilha.</strong>
          </article>

          <article class="nav-overview-group">
            <span>Configurações</span>
            <strong>Fallback, Qualificação, Sessões e Conta sempre acessíveis.</strong>
          </article>
        </div>

        <div class="nav-overview-actions">
          <button class="btn btn-primary" onclick="goToChat()">
            <i class="fa-solid fa-comments"></i>
            Abrir Chats
          </button>
          <a href="/crm" class="btn btn-accent">
            <i class="fa-solid fa-address-book"></i>
            Abrir CRM
          </a>
        </div>
      </section>

      <section class="card ai-automation-card" aria-labelledby="ia-automation-title">
        <header class="ai-automation-header">
          <div class="ai-automation-heading">
            <span class="ai-automation-icon" aria-hidden="true">
              <i class="fa-solid fa-robot"></i>
            </span>
            <div>
              <span class="ai-automation-kicker">Atendimento inteligente</span>
              <h2 id="ia-automation-title">IA Automática</h2>
              <p>Controle quando a IA pode responder às conversas.</p>
            </div>
          </div>

          <label class="switch ai-automation-switch">
            <input type="checkbox" id="ia-toggle" aria-label="Ativar IA automática" <%=user.ia_enabled ? 'checked' : '' %>
              onchange="toggleIA()">
            <span class="slider"></span>
          </label>
        </header>

        <div class="ai-automation-status-row">
          <span class="ai-automation-status-icon" aria-hidden="true">
            <i class="fa-solid fa-shield-halved"></i>
          </span>
          <div class="ai-automation-status-copy">
            <strong>Respostas automáticas</strong>
            <span>O estado é aplicado às conversas da sua conta.</span>
          </div>
          <span id="ia-status" class="ai-setting-status <%= user.ia_enabled ? 'is-enabled' : 'is-disabled' %>" role="status" aria-live="polite">
            <%= user.ia_enabled ? 'Ativada' : 'Desativada' %>
          </span>
        </div>

        <div class="silence-wrap">
          <div class="silence-header">
            <div class="silence-heading">
              <span class="silence-icon" aria-hidden="true"><i class="fa-solid fa-moon"></i></span>
              <div class="silence-heading-copy">
                <h3>Horário de silêncio</h3>
                <p>Pause as respostas automáticas durante um intervalo.</p>
              </div>
            </div>

            <div class="silence-controls">
              <span id="silence-status" class="silence-status <%= user.ia_silence_start !== null && user.ia_silence_start !== undefined ? 'is-active' : 'is-inactive' %>" role="status" aria-live="polite">
                <%= user.ia_silence_start !== null && user.ia_silence_start !== undefined ? 'Ativo' : 'Desativado' %>
              </span>
              <label class="switch switch-sm">
                <input type="checkbox" id="silence-toggle" aria-label="Ativar horário de silêncio" onchange="toggleSilence()">
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <div id="silence-config" class="silence-config" style="display:none;">
            <div class="silence-config-title">
              <i class="fa-regular fa-clock" aria-hidden="true"></i>
              <strong>Defina o intervalo de pausa</strong>
            </div>
            <div class="silence-row">
              <div class="silence-field">
                <label for="silence-start">Início</label>
                <select id="silence-start" class="silence-select">
                  <% for(let h=0; h<24; h++) { %>
                    <option value="<%= h %>"><%= String(h).padStart(2,'0') %>:00</option>
                  <% } %>
                </select>
              </div>
              <div class="silence-field">
                <label for="silence-end">Fim</label>
                <select id="silence-end" class="silence-select">
                  <% for(let h=0; h<24; h++) { %>
                    <option value="<%= h %>"><%= String(h).padStart(2,'0') %>:00</option>
                  <% } %>
                </select>
              </div>
              <button class="btn btn-accent btn-sm silence-save-button" onclick="saveSilence()">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                Salvar intervalo
              </button>
            </div>
            <p class="silence-hint">Durante esse período, as mensagens continuam chegando, mas a IA não responde automaticamente.</p>
          </div>
        </div>
      </section>

      <!-- 📱 Conexão guiada do WhatsApp -->
      <section id="whatsapp-connection" class="card connection-card" aria-labelledby="whatsapp-connection-title">
        <header class="connection-card-header">
          <span class="connection-brand-icon"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></span>
          <div>
            <span class="connection-kicker">Conexão segura por QR Code</span>
            <h2 id="whatsapp-connection-title">Conecte seu WhatsApp</h2>
            <p>Vincule o número que sua equipe usará para atender pelo ZapConnect.</p>
          </div>
        </header>

        <div class="connection-layout">
          <div class="connection-form">
            <label for="session-name">Nome para identificar esta conexão</label>
            <input id="session-name" class="textarea connection-name-input" type="text" maxlength="220"
              autocomplete="off" placeholder="Ex.: Atendimento principal">
            <p class="connection-field-hint">Esse nome aparece na sua lista de sessões. Você pode conectar mais números conforme o limite do seu plano.</p>

            <button id="session-create-btn" class="btn btn-accent full connection-create-button" type="button" onclick="createSession()">
              <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
              Gerar QR Code
            </button>

            <ol class="connection-steps" aria-label="Como conectar seu WhatsApp">
              <li><span>1</span><div><strong>Abra o WhatsApp no celular</strong><small>Use o número que deseja conectar.</small></div></li>
              <li><span>2</span><div><strong>Acesse Aparelhos conectados</strong><small>No menu do WhatsApp, toque em “Conectar aparelho”.</small></div></li>
              <li><span>3</span><div><strong>Leia o QR Code</strong><small>Aponte a câmera para o código exibido aqui.</small></div></li>
            </ol>
          </div>

          <div id="qr-preview" class="qr-area" style="display:none;" aria-live="polite">
            <span class="qr-session-label" id="qr-session-label"></span>
            <div id="connection-status" class="connection-status" role="status">A conexão será exibida aqui.</div>

            <div id="qr-loading" class="qr-loading" style="display:none;">
              <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
              <p>Preparando o pareamento…</p>
            </div>

            <img id="qr-img" class="qr-img" style="display:none;" alt="QR Code temporário para conectar o WhatsApp">

            <button id="qr-refresh" class="btn small btn-accent" type="button" style="display:none;" onclick="refreshQR()">
              <i class="fa-solid fa-rotate" aria-hidden="true"></i>
              Gerar outro QR Code
            </button>

            <p id="qr-timer" class="qr-info" aria-live="polite"></p>
            <p class="qr-security-note"><i class="fa-solid fa-lock" aria-hidden="true"></i> O código é temporário e só pode ser acessado pela sua conta.</p>
          </div>
        </div>
      </section>


    </div>
    <div id="connect-alert" class="alert-connect hidden">
      <i class="fa-solid fa-triangle-exclamation"></i>
      Nenhum WhatsApp conectado.
      Crie uma sessão e escaneie o QR Code para começar a usar o sistema.
    </div>

    <!-- 📱 Sessões -->
    <section class="card">
      <h2><i class="fa-solid fa-server"></i> WhatsApps conectados</h2>
      <div id="sessions-list"></div>
    </section>

  </main>

  <div id="ai-config-modal" class="ai-config-modal" hidden aria-hidden="true">
    <div class="ai-config-backdrop" data-ai-config-close></div>
    <section class="ai-config-dialog" role="dialog" aria-modal="true" aria-labelledby="ai-config-title">
      <header class="ai-config-dialog-header">
        <div>
          <span class="tag">Configuração guiada</span>
          <h2 id="ai-config-title"><i class="fa-solid fa-robot"></i> Configure sua IA</h2>
          <p>Preencha apenas o que fizer sentido para o seu atendimento. Você pode voltar e editar quando quiser.</p>
        </div>
        <button class="ai-config-close" type="button" aria-label="Fechar configuração da IA" data-ai-config-close>
          <i class="fa-solid fa-xmark"></i>
        </button>
      </header>

      <form id="ai-config-form">
        <div class="ai-config-scope-control">
          <label for="ai-config-scope">Aplicar configuração em</label>
          <div class="ai-config-scope-row">
            <select id="ai-config-scope" name="aiConfigScope">
              <option value="">Configuração geral (todas as sessões)</option>
            </select>
            <button id="ai-config-inherit" class="btn btn-secondary" type="button" hidden>
              Usar configuração geral
            </button>
          </div>
          <p id="ai-config-scope-hint" aria-live="polite">Esta configuração vale como padrão para todas as sessões.</p>
        </div>
        <div class="ai-config-workspace">
          <nav class="ai-config-nav" aria-label="Áreas de configuração da IA" role="tablist">
            <button type="button" class="ai-config-nav-item active" role="tab" aria-selected="true" data-ai-config-section="identity">
              <i class="fa-solid fa-user-astronaut"></i><span>1. Identidade</span>
            </button>
            <button type="button" class="ai-config-nav-item" role="tab" aria-selected="false" data-ai-config-section="objective">
              <i class="fa-solid fa-bullseye"></i><span>2. Objetivo</span>
            </button>
            <button type="button" class="ai-config-nav-item" role="tab" aria-selected="false" data-ai-config-section="knowledge">
              <i class="fa-solid fa-book-open"></i><span>3. Conhecimento</span>
            </button>
            <button type="button" class="ai-config-nav-item" role="tab" aria-selected="false" data-ai-config-section="service">
              <i class="fa-solid fa-comments"></i><span>4. Atendimento</span>
            </button>
            <button type="button" class="ai-config-nav-item" role="tab" aria-selected="false" data-ai-config-section="sales">
              <i class="fa-solid fa-cart-shopping"></i><span>5. Vendas</span>
            </button>
            <button type="button" class="ai-config-nav-item" role="tab" aria-selected="false" data-ai-config-section="scheduling">
              <i class="fa-solid fa-calendar-days"></i><span>6. Agendamento</span>
            </button>
            <button type="button" class="ai-config-nav-item" role="tab" aria-selected="false" data-ai-config-section="human">
              <i class="fa-solid fa-headset"></i><span>7. Atendimento humano</span>
            </button>
            <button type="button" class="ai-config-nav-item" role="tab" aria-selected="false" data-ai-config-section="safety">
              <i class="fa-solid fa-shield-halved"></i><span>8. Segurança</span>
            </button>
          </nav>

          <div class="ai-config-panels">
            <section class="ai-config-panel active" data-ai-config-panel="identity" role="tabpanel">
              <div class="ai-config-panel-heading">
                <span class="ai-config-step">Área 1 de 8</span>
                <h3><i class="fa-solid fa-user-astronaut" aria-hidden="true"></i> Identidade</h3>
                <p>Dê à IA uma presença coerente para que ela fale em nome da sua empresa.</p>
              </div>
              <div class="ai-config-fields ai-config-fields-two">
                <label>Nome da IA
                  <input id="ai-assistant-name" maxlength="120" placeholder="Ex.: Ana, assistente virtual da Acme">
                </label>
                <label>Nome da empresa
                  <input id="ai-company-name" maxlength="180" placeholder="Ex.: Acme Soluções">
                </label>
              </div>
              <label>Função da IA
                <textarea id="ai-role" rows="3" maxlength="1000" placeholder="Ex.: Consultora de vendas que orienta clientes e ajuda a encontrar o melhor serviço."></textarea>
              </label>
              <label>Personalidade e tom de voz
                <textarea id="ai-personality-tone" rows="3" maxlength="1000" placeholder="Ex.: Cordial, objetiva e próxima. Use português do Brasil, frases curtas e emojis apenas quando fizer sentido."></textarea>
              </label>
            </section>

            <section class="ai-config-panel" data-ai-config-panel="objective" role="tabpanel" hidden>
              <div class="ai-config-panel-heading">
                <span class="ai-config-step">Área 2 de 8</span>
                <h3><i class="fa-solid fa-bullseye" aria-hidden="true"></i> Objetivo</h3>
                <p>Explique o resultado que a IA deve buscar em cada conversa.</p>
              </div>
              <label>O que a IA deve fazer?
                <textarea id="ai-main-objective" rows="7" maxlength="2000" placeholder="Ex.: Entender a necessidade, apresentar as opções adequadas, esclarecer dúvidas e conduzir o cliente para o agendamento de uma demonstração."></textarea>
              </label>
            </section>

            <section class="ai-config-panel" data-ai-config-panel="knowledge" role="tabpanel" hidden>
              <div class="ai-config-panel-heading">
                <span class="ai-config-step">Área 3 de 8</span>
                <h3><i class="fa-solid fa-book-open" aria-hidden="true"></i> Conhecimento</h3>
                <p>Centralize as informações que ajudam a IA a responder com segurança.</p>
              </div>
              <label>Sobre a empresa
                <textarea id="ai-company-context" rows="3" maxlength="2000" placeholder="História, público atendido, localização, diferenciais e informações importantes."></textarea>
              </label>
              <label>Produtos e serviços
                <textarea id="ai-products-services" rows="4" maxlength="2000" placeholder="Descreva o que você vende, benefícios, preços ou condições que podem ser informadas."></textarea>
              </label>
              <label>Perguntas frequentes
                <textarea id="ai-faq" rows="4" maxlength="2000" placeholder="Ex.: Horário de atendimento: seg. a sex., 9h às 18h. Prazo de entrega: até 5 dias úteis."></textarea>
              </label>
              <label>Contexto adicional
                <textarea id="ai-additional-context" rows="3" maxlength="2000" placeholder="Informações que não se encaixam acima, mas que a IA precisa conhecer."></textarea>
              </label>
            </section>

            <section class="ai-config-panel" data-ai-config-panel="service" role="tabpanel" hidden>
              <div class="ai-config-panel-heading">
                <span class="ai-config-step">Área 4 de 8</span>
                <h3><i class="fa-solid fa-comments" aria-hidden="true"></i> Atendimento</h3>
                <p>Defina como começa a conversa e quais dados importam para avançar.</p>
              </div>
              <label>Saudação inicial
                <textarea id="ai-greeting" rows="3" maxlength="1000" placeholder="Ex.: Olá, {nome}! Eu sou a Ana, assistente da Acme. Como posso ajudar você hoje?"></textarea>
              </label>
              <label>Fluxo de atendimento
                <textarea id="ai-service-flow" rows="4" maxlength="2000" placeholder="Ex.: Cumprimente, descubra o que a pessoa procura, faça perguntas de contexto, apresente a opção mais adequada e indique o próximo passo."></textarea>
              </label>
              <label>Qualificação de leads
                <textarea id="ai-lead-qualification" rows="4" maxlength="2000" placeholder="Quais informações a IA deve coletar? Ex.: nome, cidade, produto de interesse, quantidade, orçamento e prazo."></textarea>
              </label>
            </section>

            <section class="ai-config-panel" data-ai-config-panel="sales" role="tabpanel" hidden>
              <div class="ai-config-panel-heading">
                <span class="ai-config-step">Área 5 de 8</span>
                <h3><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i> Vendas</h3>
                <p>Oriente a IA sobre negociações para manter as condições comerciais corretas.</p>
              </div>
              <label>Regras comerciais
                <textarea id="ai-commercial-rules" rows="5" maxlength="2000" placeholder="Formas de pagamento, descontos permitidos, frete, prazos, garantias e o que precisa de confirmação humana."></textarea>
              </label>
              <label>Objeções e respostas
                <textarea id="ai-objections" rows="5" maxlength="2000" placeholder="Ex.: Se a pessoa disser que está caro, destaque o benefício X e ofereça falar com um especialista; não ofereça desconto sem autorização."></textarea>
              </label>
            </section>

            <section class="ai-config-panel" data-ai-config-panel="scheduling" role="tabpanel" hidden>
              <div class="ai-config-panel-heading">
                <span class="ai-config-step">Área 6 de 8</span>
                <h3><i class="fa-solid fa-calendar-days" aria-hidden="true"></i> Agendamento</h3>
                <p>Informe como a IA deve lidar com reservas, horários e confirmações.</p>
              </div>
              <label>Disponibilidade
                <textarea id="ai-availability" rows="3" maxlength="1200" placeholder="Ex.: Atendimento de segunda a sexta, das 9h às 18h. Não agendar em feriados."></textarea>
              </label>
              <label>Regras para agendar
                <textarea id="ai-booking-rules" rows="4" maxlength="2000" placeholder="Quais dados coletar, antecedência mínima, duração, cancelamento e remarcação."></textarea>
              </label>
              <label>Calendário e confirmações
                <textarea id="ai-calendar-instructions" rows="3" maxlength="1200" placeholder="Ex.: Antes de confirmar, peça nome e telefone. Informe que a equipe confirmará a disponibilidade."></textarea>
              </label>
            </section>

            <section class="ai-config-panel" data-ai-config-panel="human" role="tabpanel" hidden>
              <div class="ai-config-panel-heading">
                <span class="ai-config-step">Área 7 de 8</span>
                <h3><i class="fa-solid fa-headset" aria-hidden="true"></i> Atendimento humano</h3>
                <p>Evite que a IA insista em situações que exigem uma pessoa da equipe.</p>
              </div>
              <label>Quando transferir para um humano?
                <textarea id="ai-handoff-conditions" rows="5" maxlength="2000" placeholder="Ex.: Reclamações, cancelamento, negociação fora das regras, pedido técnico complexo, solicitação explícita de falar com uma pessoa."></textarea>
              </label>
              <label>Mensagem de transferência
                <textarea id="ai-handoff-message" rows="3" maxlength="1000" placeholder="Ex.: Vou encaminhar você para uma pessoa da nossa equipe que poderá ajudar melhor. Um momento, por favor."></textarea>
              </label>
            </section>

            <section class="ai-config-panel" data-ai-config-panel="safety" role="tabpanel" hidden>
              <div class="ai-config-panel-heading">
                <span class="ai-config-step">Área 8 de 8</span>
                <h3><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Segurança e comportamento</h3>
                <p>Defina limites, como encerrar conversas e quaisquer instruções específicas.</p>
              </div>
              <label>Restrições
                <textarea id="ai-restrictions" rows="4" maxlength="2000" placeholder="Ex.: Não invente preços, disponibilidade, prazos ou políticas. Não solicite dados sensíveis. Não faça promessas em nome da empresa."></textarea>
              </label>
              <label>Encerramento
                <textarea id="ai-closing" rows="3" maxlength="1000" placeholder="Ex.: Ao finalizar, confirme se ficou alguma dúvida e se despeça de forma cordial."></textarea>
              </label>
              <label>Instruções adicionais
                <textarea id="ai-advanced-instructions" rows="4" maxlength="2000" placeholder="Regras específicas do seu negócio. Este campo é opcional."></textarea>
              </label>
            </section>
          </div>
        </div>

        <footer class="ai-config-footer">
          <span id="ai-config-progress" class="ai-config-progress">0 de 8 áreas preenchidas</span>
          <div class="ai-config-footer-actions">
            <button type="button" class="btn btn-secondary" data-ai-config-close>Cancelar</button>
            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-floppy-disk"></i>
              Salvar configuração
            </button>
          </div>
        </footer>
      </form>
    </section>
  </div>

