<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <title><%= title %> • ZapConnect</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />
  <link rel="stylesheet" href="/css/index.css" />
  <link rel="stylesheet" href="/css/mercadopago-return.css" />
  <link rel="icon" href="/img/favinco.png" />
</head>
<body class="mp-return-page">
  <main class="mp-return-shell">
    <section class="mp-return-card state-<%= state %>">
      <span class="mp-return-kicker">
        <i class="fa-solid fa-wallet"></i>
        Mercado Pago
      </span>

      <div class="mp-return-icon">
        <% if (state === "success") { %>
          <i class="fa-solid fa-circle-check"></i>
        <% } else if (state === "pending") { %>
          <i class="fa-solid fa-hourglass-half"></i>
        <% } else { %>
          <i class="fa-solid fa-circle-xmark"></i>
        <% } %>
      </div>

      <h1><%= title %></h1>
      <p><%= description %></p>

      <div class="mp-return-actions">
        <a href="/" class="btn btn-primary">
          <i class="fa-solid fa-house"></i>
          Ir para o início
        </a>
      </div>
    </section>
  </main>
</body>
</html>
