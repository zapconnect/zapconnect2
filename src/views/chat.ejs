<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <title>Chats • ZapConnect</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <%- include("partials/app-head-core") %>
  <link rel="stylesheet" href="/css/chats.css" />
  <link rel="stylesheet" href="/css/app-shell.css" />
  <script src="/js/app-shell.js" defer></script>

  <!-- ✅ Variáveis definidas ANTES do chat.js carregar -->
  <script>
    window.USER_ID = "<%= user.id %>";
    window.SESSION_NAME = "<%= typeof sessionName !== 'undefined' ? sessionName : '' %>";
    window.CHAT_BOOTSTRAP = <%- JSON.stringify({
      user: {
        plan: user?.plan || "free",
        ia_messages_used: Number(user?.ia_messages_used || 0),
        onboarding_step: Number(user?.onboarding_step || 0),
        planConfig: planConfig
          ? {
              displayName: planConfig.displayName,
              maxIaMessages: planConfig.maxIaMessages,
            }
          : null,
      },
    }) %>;
  </script>
</head>

<body class="has-app-sidebar app-chat-page">
  <%- include("partials/app-sidebar", { activePage: "chat" }) %>
  <div class="wrap">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <h1>WhatsApp • Painel</h1>
      </div>

      <div class="search">
        <input id="searchBox" placeholder="Pesquisar ou começar uma nova conversa" autocomplete="off" />
      </div>

      <div id="chatTagFilters" class="chat-tag-filters">
        <div class="chat-tag-filters-empty">Sem tags ainda</div>
      </div>

      <div id="chatlist" class="chatlist"></div>
    </aside>

    <!-- CHAT -->
    <section class="chat">

      <!-- ALERTA MODO HUMANO ATIVO -->
      <div id="humanAlert" style="display:none;">
        <i class="fa-solid fa-user-gear"></i> Atendimento humano ativo — o bot está pausado
        <br>
        <span id="humanTimer"></span>
      </div>

      <header class="chat-header">
        <div class="chat-title">
          <button id="btnToggleSidebar" class="btn-menu" title="Conversas">☰</button>
          <h2 id="chatTitle">Selecione um chat…</h2>
          <span id="tagHuman" class="tag-human" style="display:none;">HUMANO</span>
          <span id="tagAiOff" class="tag-ai-off" style="display:none;">IA DESLIGADA</span>
        </div>

        <div class="header-actions" id="humanButtons" style="display:none;">
          <div class="human-on-group">
            <button id="btnHumanOn"><i class="fa-solid fa-user-check"></i> Atender</button>
            <select id="humanDuration" class="human-duration-select" title="Duração do atendimento">
              <option value="300000">5 min</option>
              <option value="900000">15 min</option>
              <option value="1800000">30 min</option>
              <option value="null">Sem limite</option>
            </select>
          </div>
          <button id="btnHumanOff" disabled><i class="fa-solid fa-robot"></i> Retomar bot</button>
          <button id="btnAiToggle" style="display:none;"><i class="fa-solid fa-robot"></i> IA ligada</button>
          <button id="btnClearAi" title="Limpar histórico da IA" style="display:none;"><i class="fa-solid fa-broom"></i> Resetar IA</button>
        </div>

        <button id="btnContactTags" class="btn-tag-toggle" title="Classificar contato" disabled>
          <i class="fa-solid fa-tags"></i>
          <span class="btn-tag-text">Tags</span>
        </button>
        <button id="btnNotesToggle" class="btn-notes-toggle" title="Mostrar/ocultar notas">
          <i class="fa-solid fa-note-sticky"></i>
          <span class="btn-notes-text">Notas</span>
          <i class="fa-solid fa-chevron-down" id="btnNotesChevron"></i>
        </button>
        <button id="btnSearch" class="btn-search-toggle" title="Buscar na conversa"><i class="fa-solid fa-magnifying-glass"></i></button>

        <div id="contactTagDropdown" class="contact-tag-dropdown" hidden>
          <div class="contact-tag-dropdown-head">
            <span class="contact-tag-dropdown-kicker">Classificação rápida</span>
            <strong id="contactTagDropdownTitle">Selecione um contato</strong>
          </div>
          <div id="contactTagDropdownList" class="contact-tag-dropdown-list"></div>
          <div id="contactTagDropdownHint" class="contact-tag-dropdown-hint">Clique para aplicar ou remover tags deste contato.</div>
        </div>
      </header>

      <div id="chatContextBar" class="chat-context-bar is-idle">
        <div class="chat-context-main">
          <span id="contextCrmPill" class="context-pill context-crm">CRM: selecione uma conversa</span>
          <span id="contextStagePill" class="context-pill context-stage">
            <span class="pipeline-dot pipeline-Novo"></span>
            Novo
          </span>
          <span id="contextAiPill" class="context-pill context-ai context-ai-on">IA ON</span>
        </div>
        <div class="chat-context-meta">
          <span id="contextHintMeta" class="context-meta">O contexto do contato aparece aqui sem sair do chat.</span>
          <span id="contextUsageMeta" class="context-meta context-usage">0 / 0 IA no mês</span>
        </div>
      </div>

      <!-- Barra de busca -->
      <div id="searchBar" class="search-bar" style="display:none;">
        <div class="search-bar-inner">
          <input id="searchInput" class="search-bar-input" placeholder="Buscar na conversa..." autocomplete="off" />
          <span id="searchCount" class="search-count"></span>
          <button id="searchPrev" class="search-nav" title="Anterior">↑</button>
          <button id="searchNext" class="search-nav" title="Próximo">↓</button>
          <button id="searchClose" class="search-close" title="Fechar">✕</button>
        </div>
      </div>

      <!-- Notas internas (não enviadas ao cliente) -->
      <div id="notesPanel" class="notes-panel hidden">
        <div class="notes-head">
          <div class="notes-head-titles">
            <span class="notes-title">Notas internas</span>
            <span id="notesCount" class="notes-count">0</span>
          </div>
          <button id="notesRefresh" class="notes-refresh" title="Recarregar notas">Atualizar</button>
        </div>
        <div id="notesList" class="notes-list empty">Nenhuma nota interna ainda.</div>
        <form id="noteForm" class="notes-form">
          <textarea id="noteInput" class="notes-input" placeholder="Adicionar nota interna (aparece só no painel)"></textarea>
          <div class="notes-actions">
            <span class="note-helper">Use para combinar transferências ou registrar detalhes sensíveis. Não vai para o cliente.</span>
            <button type="submit" id="noteSubmit" class="notes-submit">Salvar nota</button>
          </div>
        </form>
      </div>

      <div id="draftBanner" class="draft-banner" hidden>
        <div class="draft-banner-copy">
          <span class="draft-banner-kicker">Rascunho restaurado</span>
          <strong id="draftBannerText">Você voltou para um texto salvo.</strong>
        </div>
        <button id="draftDiscard" class="draft-banner-action" type="button">
          Descartar
        </button>
      </div>

      <main id="messages" class="messages"></main>

      <!-- Preview do arquivo selecionado -->
      <div id="filePreview" class="file-preview" style="display:none;">
        <div class="file-preview-inner">
          <img id="filePreviewImg" src="" alt="" style="display:none;" />
          <div id="filePreviewDoc" class="file-preview-doc" style="display:none;">
        <span class="file-preview-icon"><i class="fa-solid fa-file-lines"></i></span>
            <span id="filePreviewName"></span>
          </div>
          <button id="fileClear" class="file-clear" title="Remover arquivo">✕</button>
        </div>
      </div>

      <footer class="chat-footer">
        <div id="quickReplyDropdown" class="quick-reply-dropdown" hidden>
          <div class="quick-reply-dropdown-head">
            <div>
              <span class="quick-reply-kicker">Respostas rápidas</span>
              <strong id="quickReplyDropdownTitle">Digite / para filtrar atalhos salvos</strong>
            </div>
            <button id="btnQuickReplyManage" class="quick-reply-manage-btn" type="button">
              Gerenciar
            </button>
          </div>

          <div id="quickReplyList" class="quick-reply-list"></div>

          <div id="quickReplyEmpty" class="quick-reply-empty" hidden>
            <strong>Nenhum atalho encontrado</strong>
            <p>Crie respostas como <code>/preco</code>, <code>/checkout</code> ou <code>/prazo</code> para acelerar o atendimento.</p>
            <button id="btnQuickReplyCreateEmpty" class="quick-reply-empty-btn" type="button">
              Criar resposta rápida
            </button>
          </div>
        </div>

        <div class="input-wrapper">
          <button class="btn-emoji" title="Emojis"><i class="fa-regular fa-face-smile"></i></button>

          <!-- Input de arquivo oculto -->
          <input type="file" id="fileInput" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.zip,.txt" style="display:none;" />
          <button class="btn-attach" id="btnAttach" title="Anexar arquivo"><i class="fa-solid fa-paperclip"></i></button>

          <textarea id="inputMsg" class="inputMsg" placeholder="Digite uma mensagem" rows="1"></textarea>
          <button id="btnSend" class="btn-send">➤</button>
        </div>
      </footer>

    </section>
  </div>

  <div id="quickReplyModal" class="quick-reply-modal" hidden>
    <div class="quick-reply-modal-backdrop" data-quick-reply-close></div>
    <div class="quick-reply-modal-card" role="dialog" aria-modal="true" aria-labelledby="quickReplyModalTitle">
      <div class="quick-reply-modal-head">
        <div>
          <span class="quick-reply-kicker">Atalhos do operador</span>
          <h3 id="quickReplyModalTitle">Respostas rápidas salvas</h3>
        </div>
        <button id="btnQuickReplyClose" class="quick-reply-modal-close" type="button" aria-label="Fechar">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="quickReplyForm" class="quick-reply-form">
        <div class="quick-reply-form-grid">
          <label class="quick-reply-field">
            <span>Atalho</span>
            <div class="quick-reply-shortcut-input">
              <span>/</span>
              <input
                id="quickReplyShortcut"
                name="shortcut"
                type="text"
                maxlength="50"
                placeholder="preco"
                autocomplete="off"
              />
            </div>
          </label>

          <label class="quick-reply-field">
            <span>Título curto</span>
            <input
              id="quickReplyTitle"
              name="title"
              type="text"
              maxlength="100"
              placeholder="Preço Plano Pro"
              autocomplete="off"
            />
          </label>
        </div>

        <label class="quick-reply-field">
          <span>Mensagem completa</span>
          <textarea
            id="quickReplyContent"
            name="content"
            rows="5"
            maxlength="6000"
            placeholder="O Plano Pro custa R$197/mês e inclui até 3 sessões..."
          ></textarea>
        </label>

        <div class="quick-reply-form-actions">
          <p class="quick-reply-form-hint">Digite <code>/atalho</code> no campo da conversa para abrir a lista em tempo real.</p>
          <button id="btnQuickReplySave" class="quick-reply-save-btn" type="submit">
            <i class="fa-solid fa-floppy-disk"></i>
            Salvar resposta
          </button>
        </div>
      </form>

      <div class="quick-reply-library-head">
        <strong>Biblioteca atual</strong>
        <span id="quickReplyCount">0 atalhos</span>
      </div>

      <div id="quickReplyManagerList" class="quick-reply-manager-list"></div>
    </div>
  </div>

  <div id="sidebarOverlay" class="sidebar-overlay"></div>

  <!-- MODAL DE EMOJIS -->
  <div id="emojiModal" class="emoji-modal">
      <div class="emoji-modal-content">
        <div class="emoji-header">
          <span><i class="fa-regular fa-face-smile"></i> Emojis</span>
          <button id="closeEmoji" class="close-emoji"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="emoji-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input id="emojiSearch" type="text" placeholder="Pesquisar emoji" autocomplete="off">
        </div>
        <div class="emoji-tabs" id="emojiTabs"></div>
        <div class="emoji-scroll" id="emojiScroll"></div>
      </div>
    </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/loading-utils.js"></script>
  <script src="/js/chat.js"></script>
</body>

</html>
