AI_SELECTED=GEMINI_FREE
# Valores aceitos: GPT ou GEMINI_FREE (alias compativel com o runtime Gemini)

OPENAI_KEY=
OPENAI_ASSISTANT=

GEMINI_KEY=
GEMINI_PROMPT=
GEMINI_MODEL=gemini-2.5-flash-lite

PORT=3000
BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional. Se vazio, usa BASE_URL/auth/google/callback
GOOGLE_REDIRECT_URI=
MP_ENCRYPTION_KEY=your_64_char_hex_key

# WhatsApp Cloud API oficial (Embedded Signup v4)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Gere uma chave exclusiva de 32 bytes em hexadecimal (64 caracteres) e mantenha-a estável.
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v27.0
